/// Sign & Monotonicity
/// Asserts that all values in a column are non-negative (>= 0). Fails with NO VALUES when the column has no non-NULL value. (Changed in 0.8.0: 0.7.x could pass a column with no values.)
function 'PQL.Assert.Col.ShouldBeNonNegative' =
		(testName : STRING, columnRef : ANYREF EXPR) =>
			VAR _MinVal = MINX(ALLNOBLANKROW(columnRef), columnRef)
			VAR _NegativeCount = COUNTAX(ALLNOBLANKROW(columnRef), IF(columnRef < 0, 1, BLANK()))
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _Passed = _HasValues && (_NegativeCount = 0)
			RETURN ROW(
				"TestName", testName,
				"Expected", "All values >= 0",
				"Actual", IF(_HasValues, IF(_Passed, "ALL NON-NEGATIVE (Min=" & FORMAT(_MinVal, "") & ")", "NEGATIVE VALUES FOUND (" & FORMAT(_NegativeCount, "0") & ", Min=" & FORMAT(_MinVal, "") & ")"), "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: 42fb141c-8a98-4320-81d2-d520b8e299a5


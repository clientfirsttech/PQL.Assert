DEFINE
	FUNCTION Perspective.ANY.Tests = () =>
		// ============================================
		// Perspective Assertion Test Suite
		// Tests for PQL.Assert.Perspective assertions
		// Target perspective definition: Just SharePoint
		// ============================================
		// Test 1: Perspective exists
		VAR _Test1 = PQL.Assert.Perspective.ShouldExist(
		    "Perspective.ShouldExist: 'Just SharePoint' should exist",
		    "Just SharePoint"
		)

		// Test 2: Perspective contains expected objects using ShouldContain (model-independent with STRING params)
		VAR _Test2 = PQL.Assert.Perspective.ShouldContain(
		    "Perspective.ShouldContain: 'Just SharePoint' contains expected objects",
		    "Just SharePoint",
		    "Test Import 1 & 3,Mock-Fact",
		    "Test Import 1 & 3[project_name],Mock-Fact[Date ID]",
		    "Test Import 1 & 3[Row Count]"
		)

		// Test 3: Perspective exact schema via CSV lists (aligned with schema-check style assertions)
		VAR _Test3 = PQL.Assert.Perspective.ShouldMatchSchema(
		    "Perspective.ShouldMatchSchema: 'Just SharePoint' should match expected schema",
		    "Just SharePoint",
		    "Test Import 1 & 3,Mock-Fact",
		    "Test Import 1 & 3[project_name],Test Import 1 & 3[project_description],Test Import 1 & 3[start_date],Test Import 1 & 3[end_date],Test Import 1 & 3[project_manager],Test Import 1 & 3[project_budget],Test Import 1 & 3[project_status],Test Import 1 & 3[client_name],Test Import 1 & 3[client_email],Test Import 1 & 3[client_phone],Mock-Fact[Date ID]",
		    "Test Import 1 & 3[Row Count]"
		)

		RETURN UNION(
		    _Test1,
		    _Test2,
		    _Test3
		)

EVALUATE Perspective.ANY.Tests()
ORDER BY [Passed], [TestName]

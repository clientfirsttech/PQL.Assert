/// Asserts that no non-NULL value in a column contains the given substring. NULL (BLANK()) rows are skipped; empty strings ("") are checked. Pass "Y" for matchCase to compare case-sensitively; default is case-insensitive. Fails with NO VALUES when the column has no non-NULL value. (Changed in 0.8.0: 0.7.x could pass a column with no values.)
function 'PQL.Assert.Col.ShouldNotContainString' =
		(testName : STRING, columnRef : ANYREF EXPR, substring : STRING, matchCase : STRING = "") =>
			VAR _CaseSensitive = UPPER(TRIM(matchCase)) IN { "Y", "YES", "TRUE", "1" }
			VAR _Values = ALLNOBLANKROW(columnRef)
			VAR _TotalCount = COUNTROWS(_Values)
			VAR _MatchingCount =
				COUNTAX(
					_Values,
					VAR _Text = FORMAT(columnRef, "")
					VAR _Found = IF(_CaseSensitive, CONTAINSSTRINGEXACT(_Text, substring), CONTAINSSTRING(_Text, substring))
					RETURN IF(NOT ISBLANK(columnRef) && _Found, 1, BLANK())
				)
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _Passed = _HasValues && (_MatchingCount = 0)
			RETURN ROW(
				"TestName", testName,
				"Expected", "No values contain '" & substring & "'" & IF(_CaseSensitive, " (case-sensitive)", " (case-insensitive)"),
				"Actual", IF(_HasValues, IF(_Passed, "NONE CONTAIN TEXT (" & FORMAT(_TotalCount, "0") & " rows)", "MATCHING VALUES (" & FORMAT(_MatchingCount, "0") & " of " & FORMAT(_TotalCount, "0") & ")"), "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: 4853fb12-9583-445e-9bab-a1ac10cbc629

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Freshness
/// Asserts that the newest value in a date/datetime column is at most maxAgeDays days before UTCNOW(). What it measures depends on the column. On a load or ingestion timestamp it checks data age (ODCS latency): the delay between the source and the model, as the model's users see it. On a refresh-log column it checks refresh recency (ODCS frequency); prefer Tbl.LastRefreshShouldBeWithinHours for that, which needs no extra column. A business date (such as an order date) can lag for legitimate reasons, such as no sales on a weekend, so it gives false failures. Fails when the column has no values. Compares against UTC, so a column stored in local time is off by the UTC offset.
function 'PQL.Assert.Col.MaxDateShouldBeWithinDays' =
		(testName : STRING, columnRef : ANYREF EXPR, maxAgeDays : DOUBLE) =>
			VAR _Latest = MAX(columnRef)
			VAR _AgeDays = IF(ISBLANK(_Latest), BLANK(), (UTCNOW() - _Latest) * 1.0)
			VAR _Passed = NOT ISBLANK(_AgeDays) && _AgeDays <= maxAgeDays
			RETURN ROW(
				"TestName", testName,
				"Expected", "Latest value within " & FORMAT(ROUND(maxAgeDays, 2), "General Number") & " day(s)",
				"Actual", IF(ISBLANK(_Latest), "NO VALUES", FORMAT(ROUND(_AgeDays, 2), "General Number") & " day(s) old"),
				"Passed", _Passed
			)
	lineageTag: 65e89c2d-1096-432b-b3ae-cafe722c5701

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that the newest value in a date/datetime column is at most maxAgeHours hours before UTCNOW(). What it measures depends on the column. On a load or ingestion timestamp it checks data age (ODCS latency): the delay between the source and the model, as the model's users see it. On a refresh-log column it checks refresh recency (ODCS frequency); prefer Tbl.LastRefreshShouldBeWithinHours for that, which needs no extra column. A business date (such as an order date) can lag for legitimate reasons, such as no sales on a weekend, so it gives false failures. Fails when the column has no values. Compares against UTC, so a column stored in local time is off by the UTC offset.
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF} columnRef - Date/datetime column, e.g. a load timestamp such as 'Orders'[LoadedAtUtc]
/// @param {DOUBLE} maxAgeHours - Largest allowed age of the latest value, in hours
function 'PQL.Assert.Col.MaxDateShouldBeWithinHours' =
		(testName : STRING, columnRef : ANYREF EXPR, maxAgeHours : DOUBLE) =>
			VAR _Latest = MAX(columnRef)
			VAR _AgeHours = IF(ISBLANK(_Latest), BLANK(), (UTCNOW() - _Latest) * 24.0)
			VAR _Passed = NOT ISBLANK(_AgeHours) && _AgeHours <= maxAgeHours
			RETURN ROW(
				"TestName", testName,
				"Expected", "Latest value within " & FORMAT(ROUND(maxAgeHours, 2), "General Number") & " hour(s)",
				"Actual", IF(ISBLANK(_Latest), "NO VALUES", FORMAT(ROUND(_AgeHours, 2), "General Number") & " hour(s) old"),
				"Passed", _Passed
			)
	lineageTag: 721cd779-8d3a-47cf-a2a1-57b79b546bf4

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Object Level Security (OLS) Assertions - PQL.Assert.OLS namespace
/// Publisher: PQL (Power Query Lint)
/// These functions test metadata visibility to verify OLS is properly configured.
/// Use with "View as" role context in Power BI Desktop to validate security settings.
/// Asserts that a table is hidden from metadata (OLS metadataPermission = none).
/// Use this when a role should NOT have access to view or query a table.
function 'PQL.Assert.OLS.TableShouldBeHidden' =
		(testName : STRING, tableName : STRING) =>
			VAR _Tables = INFO.VIEW.TABLES()
			VAR _IsVisible = COUNTROWS(FILTER(_Tables, [Name] = tableName)) > 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "Table '" & tableName & "' should be HIDDEN from metadata",
				"Actual", IF(_IsVisible, "VISIBLE (OLS not working)", "HIDDEN (OLS working)"),
				"Passed", NOT _IsVisible
			)
	lineageTag: c9c1ff23-8107-4977-9bbc-e26e2b570d80


/// Asserts that the specified percentile of a column falls within the given range. Computed over rows with NULL (BLANK()) skipped (changed in 0.8.0; 0.7.x used distinct values and ranked NULL as the lowest value). Fails with NO VALUES when the column has no non-NULL value.
function 'PQL.Assert.Col.PctileShouldBeInRange' =
		(testName : STRING, columnRef : ANYREF EXPR, pct : DOUBLE, minIncl : DOUBLE, maxIncl : DOUBLE) =>
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _PctileVal = CALCULATE(PERCENTILE.INC(columnRef, pct), REMOVEFILTERS())
			VAR _Passed = _HasValues && _PctileVal >= minIncl && _PctileVal <= maxIncl
			RETURN ROW(
				"TestName", testName,
				"Expected", "P" & FORMAT(pct * 100, "0") & " in [" & FORMAT(minIncl, "") & ", " & FORMAT(maxIncl, "") & "]",
				"Actual", IF(_HasValues, "P" & FORMAT(pct * 100, "0") & "=" & FORMAT(_PctileVal, ""), "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: 03acd2f3-eeba-4d24-a959-c30240ed91a5


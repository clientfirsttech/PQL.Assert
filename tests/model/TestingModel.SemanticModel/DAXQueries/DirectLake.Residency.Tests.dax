//     PQL.Assert.DirectLake.Col.ShouldBeResident("Critical Filter 1", "Product", "CategoryName"),
//     PQL.Assert.DirectLake.Col.ShouldBeResident("Critical Filter 2", "Date", "MonthName"),
//     PQL.Assert.DirectLake.Col.ResidencyRateShouldBeAtLeast("Fact Key Column", "Sales", "ProductKey", 80),
//     PQL.Assert.DirectLake.Tbl.ResidencyRateShouldBeAtLeast("Date Dimension", "Date", 100),

/// Asserts that at least one partition exists for the specified table, with optional date range filtering.
/// Uses INFO.PARTITIONS() to verify partition existence for table-level and incremental-refresh checks.
/// @param {STRING} testName - Description of the test being performed
/// @param {STRING} tableName - Name of the table to check partitions for
/// @param {DATETIME} [startDate] - Optional start date filter (filters by RangeStart >= startDate)
/// @param {DATETIME} [endDate] - Optional end date filter (filters by RangeEnd <= endDate)
function 'PQL.Assert.Partitions.ShouldExist' =
		(testName: STRING, tableName: STRING, startDate: DATETIME = BLANK(), endDate: DATETIME = BLANK()) =>
		    VAR _Partitions = INFO.PARTITIONS()
		    VAR _Tables =
		        SELECTCOLUMNS(
		            INFO.TABLES(),
		            "TableID", [ID],
		            "TableName", [Name]
		        )
		    VAR _PartitionMetadata = NATURALLEFTOUTERJOIN(_Partitions, _Tables)
		    VAR _PartitionMetadataWithDates =
		        ADDCOLUMNS(
		            _PartitionMetadata,
		            "_RangeStartDate", IFERROR(DATEVALUE([RangeStart]), BLANK()),
		            "_RangeEndDate", IFERROR(DATEVALUE([RangeEnd]), BLANK())
		        )
		    VAR _Filtered =
		        FILTER(
		            _PartitionMetadataWithDates,
		            [TableName] = tableName
		            && (
		                ISBLANK(startDate)
		                || (NOT ISBLANK([_RangeStartDate]) && [_RangeStartDate] >= startDate)
		            )
		            && (
		                ISBLANK(endDate)
		                || (NOT ISBLANK([_RangeEndDate]) && [_RangeEndDate] <= endDate)
		            )
		        )
		    VAR _ActualCount = COUNTROWS(_Filtered)
		    VAR _Passed = _ActualCount > 0
		    VAR _DateFilter =
		        IF(
		            NOT ISBLANK(startDate) || NOT ISBLANK(endDate),
			        " (Inclusive date bounds: " &
		            IF(NOT ISBLANK(startDate), "Start >= " & FORMAT(startDate, "yyyy-MM-dd"), "") &
		            IF(NOT ISBLANK(startDate) && NOT ISBLANK(endDate), ", ", "") &
		            IF(NOT ISBLANK(endDate), "End <= " & FORMAT(endDate, "yyyy-MM-dd"), "") &
		            ")",
		            ""
		        )
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "At least 1 partition exists" & _DateFilter,
		        "Actual", "Partition count = " & FORMAT(_ActualCount, "0") & " for table '" & tableName & "'",
		        "Passed", _Passed
		    )
	lineageTag: 92472041-2ddf-4156-a97d-9dce60ffe170

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.7.0

/// Asserts that a table has at least a minimum number of partitions, with optional date range filtering.
/// Uses INFO.PARTITIONS() to validate partition volume for incremental and rolling window partition strategies.
/// @param {STRING} testName - Description of the test being performed
/// @param {STRING} tableName - Name of the table to check partitions for
/// @param {INT64} minimumCount - Minimum partition count threshold (actual must be greater than or equal to this value)
/// @param {DATETIME} [startDate] - Optional start date filter (filters by RangeStart >= startDate)
/// @param {DATETIME} [endDate] - Optional end date filter (filters by RangeEnd <= endDate)
function 'PQL.Assert.Partitions.ShouldBeAtLeast' =
		(testName: STRING, tableName: STRING, minimumCount: INT64, startDate: DATETIME = BLANK(), endDate: DATETIME = BLANK()) =>
		    VAR _Partitions = INFO.PARTITIONS()
		    VAR _Tables =
		        SELECTCOLUMNS(
		            INFO.TABLES(),
		            "TableID", [ID],
		            "TableName", [Name]
		        )
		    VAR _PartitionMetadata = NATURALLEFTOUTERJOIN(_Partitions, _Tables)
		    VAR _PartitionMetadataWithDates =
		        ADDCOLUMNS(
		            _PartitionMetadata,
		            "_RangeStartDate", IFERROR(DATEVALUE([RangeStart]), BLANK()),
		            "_RangeEndDate", IFERROR(DATEVALUE([RangeEnd]), BLANK())
		        )
		    VAR _Filtered =
		        FILTER(
		            _PartitionMetadataWithDates,
		            [TableName] = tableName
		            && (
		                ISBLANK(startDate)
		                || (NOT ISBLANK([_RangeStartDate]) && [_RangeStartDate] >= startDate)
		            )
		            && (
		                ISBLANK(endDate)
		                || (NOT ISBLANK([_RangeEndDate]) && [_RangeEndDate] <= endDate)
		            )
		        )
		    VAR _ActualCount = COUNTROWS(_Filtered)
		    VAR _Passed = _ActualCount >= minimumCount
		    VAR _DateFilter =
		        IF(
		            NOT ISBLANK(startDate) || NOT ISBLANK(endDate),
			        " (Inclusive date bounds: " &
		            IF(NOT ISBLANK(startDate), "Start >= " & FORMAT(startDate, "yyyy-MM-dd"), "") &
		            IF(NOT ISBLANK(startDate) && NOT ISBLANK(endDate), ", ", "") &
		            IF(NOT ISBLANK(endDate), "End <= " & FORMAT(endDate, "yyyy-MM-dd"), "") &
		            ")",
		            ""
		        )
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Partition count >= " & FORMAT(minimumCount, "0") & _DateFilter,
		        "Actual", "Partition count = " & FORMAT(_ActualCount, "0") & " for table '" & tableName & "'",
		        "Passed", _Passed
		    )
	lineageTag: e6fb29ca-ebb0-4af6-96b7-53d5cba32cea

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.7.0

/// Asserts that a perspective exactly matches expected tables, columns, and measures from comma-separated lists.
/// This is a schema-check style function aligned with other PQL.Assert schema assertions.
function 'PQL.Assert.Perspective.ShouldMatchSchema' =
		(testName: STRING, perspectiveName: STRING, expectedTablesList: STRING, expectedColumnsList: STRING, expectedMeasuresList: STRING) =>
		    VAR _Perspective =
		        FILTER(
		            INFO.PERSPECTIVES(),
		            [Name] = perspectiveName
		        )
		    VAR _PerspectiveExists = COUNTROWS(_Perspective) > 0
		    VAR _PerspectiveID = MAXX(_Perspective, [ID])
		    VAR _PerspectiveTables =
		        FILTER(
		            INFO.PERSPECTIVETABLES(),
		            [PerspectiveID] = _PerspectiveID
		        )
		
		    VAR _ActualTables =
		        SELECTCOLUMNS(
		            NATURALINNERJOIN(
		                SELECTCOLUMNS(
		                    _PerspectiveTables,
		                    "TableID", [TableID]
		                ),
		                SELECTCOLUMNS(
		                    INFO.TABLES(),
		                    "TableID", [ID],
		                    "Name", [Name]
		                )
		            ),
		            "Name", [Name]
		        )
		
		    VAR _ActualColumns =
		        SELECTCOLUMNS(
		            NATURALINNERJOIN(
		                NATURALINNERJOIN(
		                    NATURALINNERJOIN(
		                        SELECTCOLUMNS(
		                            INFO.PERSPECTIVECOLUMNS(),
		                            "PerspectiveTableID", [PerspectiveTableID],
		                            "ColumnID", [ColumnID]
		                        ),
		                        SELECTCOLUMNS(
		                            _PerspectiveTables,
		                            "PerspectiveTableID", [ID],
		                            "TableID", [TableID]
		                        )
		                    ),
		                    SELECTCOLUMNS(
		                        INFO.COLUMNS(),
		                        "ColumnID", [ID],
		                        "ColumnName", IF(NOT ISBLANK([ExplicitName]), [ExplicitName], [InferredName])
		                    )
		                ),
		                SELECTCOLUMNS(
		                    INFO.TABLES(),
		                    "TableID", [ID],
		                    "TableName", [Name]
		                )
		            ),
		            "Name", [TableName] & "[" & [ColumnName] & "]"
		        )
		
		    VAR _ActualMeasures =
		        SELECTCOLUMNS(
		            NATURALINNERJOIN(
		                NATURALINNERJOIN(
		                    NATURALINNERJOIN(
		                        SELECTCOLUMNS(
		                            INFO.PERSPECTIVEMEASURES(),
		                            "PerspectiveTableID", [PerspectiveTableID],
		                            "MeasureID", [MeasureID]
		                        ),
		                        SELECTCOLUMNS(
		                            _PerspectiveTables,
		                            "PerspectiveTableID", [ID]
		                        )
		                    ),
		                    SELECTCOLUMNS(
		                        INFO.MEASURES(),
		                        "MeasureID", [ID],
		                        "MeasureTableID", [TableID],
		                        "MeasureName", [Name]
		                    )
		                ),
		                SELECTCOLUMNS(
		                    INFO.TABLES(),
		                    "MeasureTableID", [ID],
		                    "TableName", [Name]
		                )
		            ),
		            "Name", [TableName] & "[" & [MeasureName] & "]"
		        )
		
		    VAR _ExpectedTablesCount =
		        IF(
		            LEN(TRIM(expectedTablesList)) = 0,
		            0,
		            LEN(expectedTablesList) - LEN(SUBSTITUTE(expectedTablesList, ",", "")) + 1
		        )
		    VAR _ExpectedColumnsCount =
		        IF(
		            LEN(TRIM(expectedColumnsList)) = 0,
		            0,
		            LEN(expectedColumnsList) - LEN(SUBSTITUTE(expectedColumnsList, ",", "")) + 1
		        )
		    VAR _ExpectedMeasuresCount =
		        IF(
		            LEN(TRIM(expectedMeasuresList)) = 0,
		            0,
		            LEN(expectedMeasuresList) - LEN(SUBSTITUTE(expectedMeasuresList, ",", "")) + 1
		        )
		
		    VAR _ExpectedTablesUpper = "," & UPPER(expectedTablesList) & ","
		    VAR _ExpectedColumnsUpper = "," & UPPER(expectedColumnsList) & ","
		    VAR _ExpectedMeasuresUpper = "," & UPPER(expectedMeasuresList) & ","
		
		    VAR _MatchedTables =
		        FILTER(
		            _ActualTables,
		            CONTAINSSTRING(_ExpectedTablesUpper, "," & TRIM(UPPER([Name])) & ",")
		        )
		    VAR _ExtraTables =
		        FILTER(
		            _ActualTables,
		            NOT CONTAINSSTRING(_ExpectedTablesUpper, "," & TRIM(UPPER([Name])) & ",")
		        )
		
		    VAR _MatchedColumns =
		        FILTER(
		            _ActualColumns,
		            CONTAINSSTRING(_ExpectedColumnsUpper, "," & TRIM(UPPER([Name])) & ",")
		        )
		    VAR _ExtraColumns =
		        FILTER(
		            _ActualColumns,
		            NOT CONTAINSSTRING(_ExpectedColumnsUpper, "," & TRIM(UPPER([Name])) & ",")
		        )
		
		    VAR _MatchedMeasures =
		        FILTER(
		            _ActualMeasures,
		            CONTAINSSTRING(_ExpectedMeasuresUpper, "," & TRIM(UPPER([Name])) & ",")
		        )
		    VAR _ExtraMeasures =
		        FILTER(
		            _ActualMeasures,
		            NOT CONTAINSSTRING(_ExpectedMeasuresUpper, "," & TRIM(UPPER([Name])) & ",")
		        )
		
		    VAR _MissingTablesCount = COALESCE(MAX(0, _ExpectedTablesCount - COUNTROWS(_MatchedTables)), 0)
		    VAR _MissingColumnsCount = COALESCE(MAX(0, _ExpectedColumnsCount - COUNTROWS(_MatchedColumns)), 0)
		    VAR _MissingMeasuresCount = COALESCE(MAX(0, _ExpectedMeasuresCount - COUNTROWS(_MatchedMeasures)), 0)
		
		    VAR _ExtraTablesCount = COALESCE(COUNTROWS(_ExtraTables), 0)
		    VAR _ExtraColumnsCount = COALESCE(COUNTROWS(_ExtraColumns), 0)
		    VAR _ExtraMeasuresCount = COALESCE(COUNTROWS(_ExtraMeasures), 0)
		
		    VAR _MissingTotal = _MissingTablesCount + _MissingColumnsCount + _MissingMeasuresCount
		    VAR _ExtraTotal = _ExtraTablesCount + _ExtraColumnsCount + _ExtraMeasuresCount
		    VAR _Passed = _PerspectiveExists && _MissingTotal = 0 && _ExtraTotal = 0
		
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Perspective schema exactly matches expected tables/columns/measures",
		        "Actual", IF(
		            NOT _PerspectiveExists,
		            "Perspective not found",
		            "Missing=" & FORMAT(_MissingTotal, "0") & ", Extra=" & FORMAT(_ExtraTotal, "0")
		        ),
		        "Passed", _Passed
		    )
	lineageTag: 9af44ab8-ddd3-4a8a-a6f2-f63745b51797

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.7.0

/// Core PQL.Assert assertion tests. Registered so pql-test discovers it via RetrieveTestsV2.
function 'Assert.ANY.Tests' =
		() =>
			VAR _TestTableWithRows = DATATABLE("Col1", STRING, "Col2", INTEGER, {{"A", 1}, {"B", 2}, {"C", 3}})
			VAR _EmptyTable = FILTER(_TestTableWithRows, FALSE)
			VAR _TestTableWithDupes = DATATABLE("DupeCol", STRING, {{"A"}, {"A"}, {"B"}})
			VAR _ShouldBeTrue_Pass = PQL.Assert.ShouldBeTrue("ShouldBeTrue: TRUE should pass", TRUE)
			VAR _ShouldBeTrue_Fail = PQL.Assert.ShouldBeTrue("ShouldBeTrue: FALSE should fail", FALSE)
			VAR _ShouldBeFalse_Pass = PQL.Assert.ShouldBeFalse("ShouldBeFalse: FALSE should pass", FALSE)
			VAR _ShouldBeFalse_Fail = PQL.Assert.ShouldBeFalse("ShouldBeFalse: TRUE should fail", TRUE)
			VAR _ShouldBeNull_Pass = PQL.Assert.ShouldBeNull("ShouldBeNull: BLANK should pass", BLANK())
			VAR _ShouldBeNull_Fail_Value = PQL.Assert.ShouldBeNull("ShouldBeNull: 42 should fail", 42)
			VAR _ShouldBeNull_Fail_Empty = PQL.Assert.ShouldBeNull("ShouldBeNull: Empty string should fail", "")
			VAR _ShouldNotBeNull_Pass_Value = PQL.Assert.ShouldNotBeNull("ShouldNotBeNull: 42 should pass", 42)
			VAR _ShouldNotBeNull_Pass_Empty = PQL.Assert.ShouldNotBeNull("ShouldNotBeNull: Empty string should pass", "")
			VAR _ShouldNotBeNull_Fail = PQL.Assert.ShouldNotBeNull("ShouldNotBeNull: BLANK should fail", BLANK())
			VAR _ShouldBeBlank_Pass = PQL.Assert.ShouldBeBlank("ShouldBeBlank: Empty string should pass", "")
			VAR _ShouldBeBlank_Fail_Value = PQL.Assert.ShouldBeBlank("ShouldBeBlank: 42 should fail", 42)
			VAR _ShouldBeBlank_Fail_Null = PQL.Assert.ShouldBeBlank("ShouldBeBlank: BLANK should fail", BLANK())
			VAR _ShouldNotBeBlank_Pass_Value = PQL.Assert.ShouldNotBeBlank("ShouldNotBeBlank: 42 should pass", 42)
			VAR _ShouldNotBeBlank_Pass_Null = PQL.Assert.ShouldNotBeBlank("ShouldNotBeBlank: _ should pass", "_")
			VAR _ShouldNotBeBlank_Fail = PQL.Assert.ShouldNotBeBlank("ShouldNotBeBlank: Empty string should fail", "")
			VAR _ShouldBeNullOrBlank_Pass_Null = PQL.Assert.ShouldBeNullOrBlank("ShouldBeNullOrBlank: BLANK should pass", BLANK())
			VAR _ShouldBeNullOrBlank_Pass_Empty = PQL.Assert.ShouldBeNullOrBlank("ShouldBeNullOrBlank: Empty string should pass", "")
			VAR _ShouldBeNullOrBlank_Fail = PQL.Assert.ShouldBeNullOrBlank("ShouldBeNullOrBlank: 42 should fail", 42)
			VAR _ShouldNotBeNullOrBlank_Pass = PQL.Assert.ShouldNotBeNullOrBlank("ShouldNotBeNullOrBlank: 42 should pass", 42)
			VAR _ShouldNotBeNullOrBlank_Fail_Null = PQL.Assert.ShouldNotBeNullOrBlank("ShouldNotBeNullOrBlank: BLANK should fail", BLANK())
			VAR _ShouldNotBeNullOrBlank_Fail_Empty = PQL.Assert.ShouldNotBeNullOrBlank("ShouldNotBeNullOrBlank: Empty string should fail", "")
			VAR _ShouldEqual_Pass_Int = PQL.Assert.ShouldEqual("ShouldEqual: 10=10 should pass", 10, 10)
			VAR _ShouldEqual_Pass_Str = PQL.Assert.ShouldEqual("ShouldEqual: String equality should pass", "Hello", "Hello")
			VAR _ShouldEqual_Pass_Decimal = PQL.Assert.ShouldEqual("ShouldEqual: Decimal 3.14=3.14 should pass", 3.14, 3.14)
			VAR _ShouldEqual_Pass_Bool = PQL.Assert.ShouldEqual("ShouldEqual: Boolean TRUE=TRUE should pass", TRUE, TRUE)
			VAR _ShouldEqual_Pass_Date = PQL.Assert.ShouldEqual("ShouldEqual: Date equality should pass", DATE(2024,1,1), DATE(2024,1,1))
			VAR _ShouldEqual_Pass_DateTime = PQL.Assert.ShouldEqual("ShouldEqual: DateTime equality should pass", DATE(2024,1,1) + TIME(12,30,45), DATE(2024,1,1) + TIME(12,30,45))
			VAR _ShouldEqual_Pass_Null = PQL.Assert.ShouldEqual("ShouldEqual: NULL=NULL should pass", BLANK(), BLANK())
			VAR _ShouldEqual_Fail_Int = PQL.Assert.ShouldEqual("ShouldEqual: 10=20 should fail", 10, 20)
			VAR _ShouldEqual_Fail_Str = PQL.Assert.ShouldEqual("ShouldEqual: Different strings should fail", "Hello", "World")
			VAR _ShouldEqual_Fail_Bool = PQL.Assert.ShouldEqual("ShouldEqual: TRUE=FALSE should fail", TRUE, FALSE)
			VAR _ShouldEqual_Fail_DateTime = PQL.Assert.ShouldEqual("ShouldEqual: Different DateTimes should fail", DATE(2024,1,1) + TIME(12,30,45), DATE(2024,1,1) + TIME(12,30,46))
			VAR _ShouldEqual_Fail_DateVsDateTime = PQL.Assert.ShouldEqual("ShouldEqual: Date vs DateTime should fail", DATE(2024,1,1), DATE(2024,1,1) + TIME(1,0,0))
			VAR _ShouldEqual_Fail_MixedType = PQL.Assert.ShouldEqual("ShouldEqual: Mixed types 10='10' should fail", 10, "10")
			VAR _ShouldNotEqual_Pass_Int = PQL.Assert.ShouldNotEqual("ShouldNotEqual: 10<>20 should pass", 10, 20)
			VAR _ShouldNotEqual_Pass_Str = PQL.Assert.ShouldNotEqual("ShouldNotEqual: Different strings should pass", "Hello", "World")
			VAR _ShouldNotEqual_Pass_Bool = PQL.Assert.ShouldNotEqual("ShouldNotEqual: TRUE<>FALSE should pass", TRUE, FALSE)
			VAR _ShouldNotEqual_Pass_DateTime = PQL.Assert.ShouldNotEqual("ShouldNotEqual: Different DateTimes should pass", DATE(2024,1,1) + TIME(12,30,45), DATE(2024,1,1) + TIME(12,30,46))
			VAR _ShouldNotEqual_Pass_DateVsDateTime = PQL.Assert.ShouldNotEqual("ShouldNotEqual: Date<>DateTime should pass", DATE(2024,1,1), DATE(2024,1,1) + TIME(1,0,0))
			VAR _ShouldNotEqual_Pass_MixedType = PQL.Assert.ShouldNotEqual("ShouldNotEqual: Mixed types 10<>'10' should pass", 10, "10")
			VAR _ShouldNotEqual_Fail_Int = PQL.Assert.ShouldNotEqual("ShouldNotEqual: 10<>10 should fail", 10, 10)

/// Asserts that a string ends with the specified suffix (case-insensitive). A NULL (BLANK()) actual value fails (changed in 0.8.0; 0.7.x compared it as "").
function 'PQL.Assert.ShouldEndWith' =
		(testName : STRING, suffix : STRING, actual : STRING) =>
		    VAR _Passed = NOT ISBLANK(actual) && RIGHT(UPPER(actual), LEN(suffix)) = UPPER(suffix)
		    RETURN ROW(

/// Categorical / Membership / Format
/// Asserts that all values in a column are in the specified allowed set (table). NULL (BLANK()) values are skipped, like the text checks (changed in 0.8.0; 0.7.x reported NULL as outside the set). Fails with NO VALUES when the column has no non-NULL value.
function 'PQL.Assert.Col.ValuesShouldBeInSet' =
		(testName : STRING, columnRef : ANYREF EXPR, allowedValuesTable : TABLE EXPR, allowedValuesColumn : ANYREF EXPR) =>
			VAR _TargetValues = SELECTCOLUMNS(
				FILTER(DISTINCT(columnRef), NOT ISBLANK(columnRef)),
				"@Value", CONVERT(columnRef, STRING)
			)
			VAR _AllowedValues = SELECTCOLUMNS(
				allowedValuesTable,
				"@Value", CONVERT(allowedValuesColumn, STRING)
			)
			VAR _InvalidCount = COUNTROWS(EXCEPT(_TargetValues, _AllowedValues))
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _Passed = _HasValues && (_InvalidCount = 0)
			RETURN ROW(
				"TestName", testName,
				"Expected", "All values in allowed set",
				"Actual", IF(_HasValues, IF(_Passed, "ALL VALUES IN SET", "VALUES OUTSIDE SET (" & FORMAT(_InvalidCount, "0") & " invalid)"), "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: 99ab076d-4174-4b96-8d8d-7c653bd293d0

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that no values in a column are in the specified banned set (table). NULL (BLANK()) values are skipped (changed in 0.8.0). Fails with NO VALUES when the column has no non-NULL value.
function 'PQL.Assert.Col.ValuesShouldNotBeInSet' =
		(testName : STRING, columnRef : ANYREF EXPR, bannedValuesTable : TABLE EXPR, bannedValuesColumn : ANYREF EXPR) =>
			VAR _TargetValues = SELECTCOLUMNS(
				FILTER(DISTINCT(columnRef), NOT ISBLANK(columnRef)),
				"@Value", CONVERT(columnRef, STRING)
			)
			VAR _BannedValues = SELECTCOLUMNS(
				bannedValuesTable,
				"@Value", CONVERT(bannedValuesColumn, STRING)
			)
			VAR _BannedFound = COUNTROWS(INTERSECT(_TargetValues, _BannedValues))
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _Passed = _HasValues && (_BannedFound = 0)
			RETURN ROW(
				"TestName", testName,
				"Expected", "No values in banned set",
				"Actual", IF(_HasValues, IF(_Passed, "NO BANNED VALUES FOUND", "BANNED VALUES FOUND (" & FORMAT(_BannedFound, "0") & ")"), "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: 77a4251f-2ed0-451f-9c7d-653f88d05dc6

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that the distinct count of values in a column is at most the specified number. Uses DISTINCTCOUNT, so NULL (BLANK()) counts as one value.
function 'PQL.Assert.Col.DistinctCountShouldBeAtMost' =
		(testName : STRING, columnRef : ANYREF EXPR, maxDistinct : INT64) =>
			VAR _DistinctCount = DISTINCTCOUNT(columnRef)
			VAR _Passed = _DistinctCount <= maxDistinct
			RETURN ROW(
				"TestName", testName,
				"Expected", "Distinct count <= " & FORMAT(maxDistinct, "0"),
				"Actual", "Distinct count = " & FORMAT(_DistinctCount, "0"),
				"Passed", _Passed
			)
	lineageTag: 32de4ee8-1b7f-4eac-92d1-d932265efd88

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that the distinct count of values in a column is at least the specified number. Uses DISTINCTCOUNT, so NULL (BLANK()) counts as one value.
function 'PQL.Assert.Col.DistinctCountShouldBeAtLeast' =
		(testName : STRING, columnRef : ANYREF EXPR, minDistinct : INT64) =>

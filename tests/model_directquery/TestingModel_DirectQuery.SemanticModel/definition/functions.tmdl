/// Asserts that the maximum value in a column is at most the specified value. Fails with NO VALUES when the column has no non-NULL value. (Changed in 0.8.0: 0.7.x could pass a column with no values.)
function 'PQL.Assert.Col.MaxShouldBeAtMost' =
		(testName : STRING, columnRef : ANYREF EXPR, maxIncl : DOUBLE) =>
			VAR _MaxVal = MAXX(ALLNOBLANKROW(columnRef), columnRef)
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _Passed = _HasValues && (_MaxVal <= maxIncl)
			RETURN ROW(
				"TestName", testName,
				"Expected", "Max <= " & FORMAT(maxIncl, ""),
				"Actual", IF(_HasValues, "Max=" & FORMAT(_MaxVal, ""), "NO VALUES"),
				"Passed", _Passed

/// Asserts whether column is available for MDX queries. Prevents problems for downstream Analyze in Excel users
function 'PQL.Assert.Col.IsAvailableInMDX' =
		(testName : STRING, tableName : STRING, columnName : STRING) =>
			VAR _ColumnID = MAXX(FILTER(INFO.VIEW.COLUMNS(), [Table] = tableName && [Name] = columnName), [ID])
			VAR _ColumnExists = NOT ISBLANK(_ColumnID)
			VAR _IsMDXActive = COUNTROWS(FILTER(INFO.COLUMNS(), [ID] = _ColumnID && [IsAvailableInMDX] = TRUE())) = 1
			RETURN ROW(
				"TestName", testName,
				"Expected", "Column '" & tableName & "'[" & columnName & "] should be available in MDX",
				"Actual", SWITCH(TRUE(), NOT _ColumnExists, "Column not found", _IsMDXActive, "Available in MDX", "Not available in MDX"),
				"Passed", _ColumnExists && _IsMDXActive,
				"IsMDXActive", _IsMDXActive
			)

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.7.0

/// Asserts that every non-blank value in a column starts with the given prefix. Uses LEFT() (DAX has no STARTSWITH). Pass "Y" for matchCase to compare case-sensitively; default is case-insensitive.
function 'PQL.Assert.Col.ShouldStartWith' =
		(testName : STRING, columnRef : ANYREF EXPR, prefix : STRING, matchCase : STRING = "") =>
			VAR _CaseSensitive = UPPER(TRIM(matchCase)) IN { "Y", "YES", "TRUE", "1" }
			VAR _PrefixLen = LEN(prefix)
			VAR _Prefix = IF(_CaseSensitive, prefix, UPPER(prefix))
			VAR _Values = ALLNOBLANKROW(columnRef)
			VAR _TotalCount = COUNTROWS(_Values)
			VAR _NonMatchingCount =
				COUNTAX(
					_Values,
					VAR _Head = LEFT(FORMAT(columnRef, ""), _PrefixLen)
					VAR _Candidate = IF(_CaseSensitive, _Head, UPPER(_Head))
					RETURN IF(NOT ISBLANK(columnRef) && NOT EXACT(_Candidate, _Prefix), 1, BLANK())
				)
			VAR _Passed = _NonMatchingCount = 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "All values start with '" & prefix & "'" & IF(_CaseSensitive, " (case-sensitive)", " (case-insensitive)"),
				"Actual", IF(_Passed, "ALL START WITH PREFIX (" & FORMAT(_TotalCount, "0") & " rows)", "NON-MATCHING VALUES (" & FORMAT(_NonMatchingCount, "0") & " of " & FORMAT(_TotalCount, "0") & ")"),
				"Passed", _Passed
			)

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.7.0

/// Asserts that no non-blank value in a column starts with the given prefix. Uses LEFT() (DAX has no STARTSWITH). Pass "Y" for matchCase to compare case-sensitively; default is case-insensitive.
function 'PQL.Assert.Col.ShouldNotStartWith' =
		(testName : STRING, columnRef : ANYREF EXPR, prefix : STRING, matchCase : STRING = "") =>
			VAR _CaseSensitive = UPPER(TRIM(matchCase)) IN { "Y", "YES", "TRUE", "1" }
			VAR _PrefixLen = LEN(prefix)
			VAR _Prefix = IF(_CaseSensitive, prefix, UPPER(prefix))
			VAR _Values = ALLNOBLANKROW(columnRef)
			VAR _TotalCount = COUNTROWS(_Values)
			VAR _MatchingCount =
				COUNTAX(
					_Values,
					VAR _Head = LEFT(FORMAT(columnRef, ""), _PrefixLen)
					VAR _Candidate = IF(_CaseSensitive, _Head, UPPER(_Head))
					RETURN IF(NOT ISBLANK(columnRef) && EXACT(_Candidate, _Prefix), 1, BLANK())
				)
			VAR _Passed = _MatchingCount = 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "No values start with '" & prefix & "'" & IF(_CaseSensitive, " (case-sensitive)", " (case-insensitive)"),
				"Actual", IF(_Passed, "NONE START WITH PREFIX (" & FORMAT(_TotalCount, "0") & " rows)", "MATCHING VALUES (" & FORMAT(_MatchingCount, "0") & " of " & FORMAT(_TotalCount, "0") & ")"),
				"Passed", _Passed
			)


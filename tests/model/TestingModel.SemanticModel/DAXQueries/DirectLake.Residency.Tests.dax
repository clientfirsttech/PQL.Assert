DEFINE

// ============================================
// Direct Lake Residency Test Suite
// Tests for PQL.Assert.DirectLake.Col and PQL.Assert.DirectLake.Tbl functions
// Validates column segment residency using INFO.STORAGETABLECOLUMNSEGMENTS()
// ============================================

// Note: These tests require a Direct Lake semantic model with actual segments.
// On Import/DirectQuery models, all tests will fail with "no segments" message.
// Replace placeholder table/column names with actual Direct Lake tables in your model.

FUNCTION DirectLake.Residency.DEV.Tests = () =>
    
    // ============================================
    // Test Group 1: Column-level full residency checks
    // ============================================
    
    // Test 1: Should fail if column doesn't exist or isn't Direct Lake
    VAR _Test1 = PQL.Assert.DirectLake.Col.ShouldBeResident(
        "DL.Col.ShouldBeResident: NonExistentTable[Column] should fail gracefully",
        'NonExistentTable'[NonExistentColumn]
    )
    
    // Test 2: Example test for an actual Direct Lake column (update with your table/column names)
    // VAR _Test2 = PQL.Assert.DirectLake.Col.ShouldBeResident(
    //     "DL.Col.ShouldBeResident: YourTable[YourColumn] should be fully resident",
    //     'YourTable'[YourColumn]
    // )
    
    // ============================================
    // Test Group 2: Column-level NOT resident checks
    // ============================================
    
    // Test 3: Should pass when column has no resident segments (cold start)
    VAR _Test3 = PQL.Assert.DirectLake.Col.ShouldNotBeResident(
        "DL.Col.ShouldNotBeResident: NonExistent column should fail (no segments)",
        'NonExistentTable'[NonExistentColumn]
    )
    
    // Test 4: Example test for verifying column is evicted from memory
    // VAR _Test4 = PQL.Assert.DirectLake.Col.ShouldNotBeResident(
    //     "DL.Col.ShouldNotBeResident: LargeColumn should not be resident after eviction",
    //     'LargeTable'[LargeColumn]
    // )
    
    // ============================================
    // Test Group 3: Table-level residency checks
    // ============================================
    
    // Test 6: Should fail gracefully on non-existent table
    VAR _Test6 = PQL.Assert.DirectLake.Tbl.ResidencyRateShouldBeAtLeast(
        "DL.Tbl.ResidencyRateShouldBeAtLeast: NonExistentTable should fail gracefully",
        NonExistentTable,
        50
    )
    
    // Test 7: Example test for dimension table (should be highly resident)
    // VAR _Test7 = PQL.Assert.DirectLake.Tbl.ResidencyRateShouldBeAtLeast(
    //     "DL.Tbl.ResidencyRateShouldBeAtLeast: Date dimension should be >= 90% resident",
    //     'Date',
    //     90
    // )
    
    // Test 8: Example test for fact table (may have lower residency)
    // VAR _Test8 = PQL.Assert.DirectLake.Tbl.ResidencyRateShouldBeAtLeast(
    //     "DL.Tbl.ResidencyRateShouldBeAtLeast: Sales fact should be >= 50% resident",
    //     Sales,
    //     50
    // )
    
    RETURN UNION(
        _Test1,
        _Test3,
        _Test6
        // Add your actual tests here when testing with a real Direct Lake model
        // _Test2,
        // _Test4,
        // _Test5,
        // _Test7,
        // _Test8
    )

EVALUATE DirectLake.Residency.DEV.Tests()

// ============================================
// Usage Examples (commented out - uncomment to use with actual Direct Lake model)
// ============================================


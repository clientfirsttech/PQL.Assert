/// Asserts that a column contains no duplicate values. Alias for ShouldBeDistinct. Deprecated: use NonNullValuesShouldBeDistinct (blanks ignored) or ShouldBePrimaryKey (blanks fail). Compares DISTINCTCOUNT, which counts BLANK as a value, with COUNTA, which ignores it: one BLANK fails an otherwise distinct column, and {1, 1, BLANK} passes.
function 'PQL.Assert.Col.ShouldNotContainDuplicates' =
		(testName : STRING, columnRef : ANYREF EXPR) =>
			VAR _DistinctCount = DISTINCTCOUNT(columnRef)
			VAR _TotalCount = COUNTA(columnRef)
			VAR _Passed = _DistinctCount = _TotalCount
			RETURN ROW(
				"TestName", testName,
				"Expected", "No duplicate values",
				"Actual", IF(_Passed, "NO DUPLICATES (" & FORMAT(_TotalCount, "0") & " rows)", "DUPLICATES FOUND (" & FORMAT(_DistinctCount, "0") & " distinct of " & FORMAT(_TotalCount, "0") & " rows)"),
				"Passed", _Passed
			)
	lineageTag: 6f43bc13-4ad3-4395-b22e-0bc2d1e5be94

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that the non-NULL values in a column are all distinct. NULL (BLANK()) rows are ignored; empty strings ("") count as values. Use ShouldBePrimaryKey to also forbid NULL and empty values. Fails with NO VALUES when the column has no non-NULL value.
function 'PQL.Assert.Col.NonNullValuesShouldBeDistinct' =
		(testName : STRING, columnRef : ANYREF EXPR) =>
			VAR _Distinct = DISTINCTCOUNTNOBLANK(columnRef) + 0
			VAR _NonNull = COUNTA(columnRef) + 0
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _Passed = _HasValues && (_Distinct = _NonNull)
			RETURN ROW(
				"TestName", testName,
				"Expected", "Non-null values distinct",
				"Actual", IF(_HasValues, FORMAT(_Distinct, "0") & " distinct of " & FORMAT(_NonNull, "0") & " non-null", "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: 202bdd24-cd89-439b-bd47-6537aa28ccd4

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that a column can serve as a primary key: no NULL (BLANK()) or empty-string ("") rows, and all values distinct.
function 'PQL.Assert.Col.ShouldBePrimaryKey' =
		(testName : STRING, columnRef : ANYREF EXPR) =>
			VAR _NullOrBlank = COUNTBLANK(columnRef) + 0
			VAR _Distinct = DISTINCTCOUNTNOBLANK(columnRef) + 0
			VAR _NonNull = COUNTA(columnRef) + 0
			VAR _Passed = _NullOrBlank = 0 && _Distinct = _NonNull
			RETURN ROW(
				"TestName", testName,
				"Expected", "No null or blank values and all values distinct",
				"Actual", FORMAT(_NullOrBlank, "0") & " null or blank, " & FORMAT(_Distinct, "0") & " distinct of " & FORMAT(_NonNull, "0"),
				"Passed", _Passed
			)
	lineageTag: 20ab2e62-a5d0-46da-b23c-b8fd2166a870

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that a column has at most maxCount duplicate values among its non-NULL rows (non-NULL rows minus distinct non-NULL values). NULL (BLANK()) rows are ignored. Fails with NO VALUES when the column has no non-NULL value.
function 'PQL.Assert.Col.DuplicateCountShouldBeAtMost' =
		(testName : STRING, columnRef : ANYREF EXPR, maxCount : INT64) =>
			VAR _Duplicates = (COUNTA(columnRef) + 0) - (DISTINCTCOUNTNOBLANK(columnRef) + 0)
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _Passed = _HasValues && (_Duplicates <= maxCount)
			RETURN ROW(
				"TestName", testName,
				"Expected", "Duplicate values <= " & FORMAT(maxCount, "0"),
				"Actual", IF(_HasValues, FORMAT(_Duplicates, "0"), "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: 906f89fa-2573-4297-b93c-018c808776ae

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Range & Distribution Checks (Numeric)
/// Asserts that all values in a numeric column fall within the specified inclusive range. Fails with NO VALUES when the column has no non-NULL value. (Changed in 0.8.0: 0.7.x could pass a column with no values.)
function 'PQL.Assert.Col.ShouldBeInRange' =
		(testName : STRING, columnRef : ANYREF EXPR, minIncl : DOUBLE, maxIncl : DOUBLE) =>
			VAR _MinVal = MINX(ALLNOBLANKROW(columnRef), columnRef)
			VAR _MaxVal = MAXX(ALLNOBLANKROW(columnRef), columnRef)
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _Passed = _HasValues && (_MinVal >= minIncl && _MaxVal <= maxIncl)
			RETURN ROW(
				"TestName", testName,
				"Expected", FORMAT(minIncl, "") & " <= value <= " & FORMAT(maxIncl, ""),
				"Actual", IF(_HasValues, "Min=" & FORMAT(_MinVal, "") & ", Max=" & FORMAT(_MaxVal, ""), "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: 56d898ae-a457-4c4f-a7f0-0abd94ff5464

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that the minimum value in a column is at least the specified value. Fails with NO VALUES when the column has no non-NULL value. (Changed in 0.8.0: 0.7.x could pass a column with no values.)
function 'PQL.Assert.Col.MinShouldBeAtLeast' =
		(testName : STRING, columnRef : ANYREF EXPR, minIncl : DOUBLE) =>
			VAR _MinVal = MINX(ALLNOBLANKROW(columnRef), columnRef)
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _Passed = _HasValues && (_MinVal >= minIncl)
			RETURN ROW(
				"TestName", testName,
				"Expected", "Min >= " & FORMAT(minIncl, ""),
				"Actual", IF(_HasValues, "Min=" & FORMAT(_MinVal, ""), "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: ed222f6f-ee8e-4d1a-b234-2679f7c5e986


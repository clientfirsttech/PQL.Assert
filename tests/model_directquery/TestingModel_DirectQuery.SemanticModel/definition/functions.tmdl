/// Asserts that text lengths in a column fall within the specified range. Fails with NO VALUES when the column has no non-NULL value. (Changed in 0.8.0: 0.7.x could pass a column with no values.)
function 'PQL.Assert.Col.TextLengthShouldBeInRange' =
		(testName : STRING, columnRef : ANYREF EXPR, minLen : INT64, maxLen : INT64) =>
			VAR _TotalCount = COUNTROWS(ALLNOBLANKROW(columnRef))
			VAR _OutOfRangeCount = COUNTAX(ALLNOBLANKROW(columnRef), IF(NOT ISBLANK(columnRef) && (LEN(FORMAT(columnRef, "")) < minLen || LEN(FORMAT(columnRef, "")) > maxLen), 1, BLANK()))
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _Passed = _HasValues && (_OutOfRangeCount = 0)
			RETURN ROW(
				"TestName", testName,
				"Expected", "Text length in [" & FORMAT(minLen, "0") & ", " & FORMAT(maxLen, "0") & "]",
				"Actual", IF(_HasValues, IF(_Passed, "ALL IN RANGE (" & FORMAT(_TotalCount, "0") & " rows)", "OUT OF RANGE (" & FORMAT(_OutOfRangeCount, "0") & " of " & FORMAT(_TotalCount, "0") & ")"), "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: 0ecd113f-1466-4318-9aff-beba8dbc49c7


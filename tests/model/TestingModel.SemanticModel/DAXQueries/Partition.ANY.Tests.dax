DEFINE
	FUNCTION Partition.ANY.Tests = () =>
		// ============================================
		// Partition Assertion Test Suite
		// Tests for PQL.Assert.Partitions.ShouldBe, ShouldExist, and ShouldBeAtLeast
		// Includes explicit inclusive date-bound checks for ShouldBe and ShouldBeAtLeast
		// ============================================
		// ============================================
		// Test Group 1: Basic partition count (no date filtering)
		// ============================================

		// Test 1: Existence check without date filters
		VAR _Test1 = PQL.Assert.Partitions.ShouldExist(
		    "Partitions.ShouldExist: Test Import 1 & 3 should have at least one partition (no date filter)",
		    "Test Import 1 & 3"
		)

		// Test 2: At-least threshold check without date filters
		VAR _Test2 = PQL.Assert.Partitions.ShouldBeAtLeast(
		    "Partitions.ShouldBeAtLeast: Test Import 1 & 3 count should be >= 1 (no date filter)",
		    "Test Import 1 & 3",
		    1
		)

		// ============================================
		// Test Group 2: Date filtering with startDate only
		// ============================================

		// Test 3: Inclusive lower bound check (startDate only)
		VAR _Test3 = PQL.Assert.Partitions.ShouldBeAtLeast(
		    "Partitions.ShouldBeAtLeast: Inclusive start >= 2020-01-01 should return count >= 30",
		    "Test Import 1 & 3",
		    30,
		    DATE(2020, 1, 1),
		    BLANK()
		)

		// Test 4: Inclusive upper bound check (endDate only)
		VAR _Test4 = PQL.Assert.Partitions.ShouldBe(
		    "Partitions.ShouldBe: Inclusive end <= 2026-04-30 should return count = 2",
		    "Test Import 1 & 3",
		    2,
		    BLANK(),
		   DATE(2026, 4, 30)
		)

		// ============================================
		// Test Group 3: Date filtering with endDate only
		// ============================================

		// Test 5: Inclusive upper bound pre-incremental window
		VAR _Test5 = PQL.Assert.Partitions.ShouldBe(
		    "Partitions.ShouldBe: Inclusive end <= 2025-12-31 should return count = 0",
		    "Test Import 1 & 3",
		    0,
		    BLANK(),
		    DATE(2025, 12, 31)
		)

		// Test 6: Inclusive upper bound broad range with at-least threshold
		VAR _Test6 = PQL.Assert.Partitions.ShouldBeAtLeast(
		    "Partitions.ShouldBeAtLeast: Inclusive end <= 2027-12-31 should return count >= 34",
		    "Test Import 1 & 3",
		    34,
		    BLANK(),
		    DATE(2027, 12, 31)
		)

		// ============================================
		// Test Group 4: Date filtering with both startDate and endDate
		// ============================================

		// Test 7: Inclusive two-sided range with expected zero partitions
		VAR _Test7 = PQL.Assert.Partitions.ShouldBe(
		    "Partitions.ShouldBe: Inclusive range 2023-01-01..2024-12-31 should return count = 0",
		    "Test Import 1 & 3",
		    0,
		    DATE(2023, 1, 1),
		    DATE(2024, 12, 31)
		)

		// Test 8: Inclusive narrow two-sided range
		VAR _Test8 = PQL.Assert.Partitions.ShouldBe(
		    "Partitions.ShouldBe: Inclusive range 2026-01-01..2026-04-01 should return count = 1",
		    "Test Import 1 & 3",
		    1,
		    DATE(2026, 1, 1),
		    DATE(2026, 4, 1)
		)

		// Test 9: Inclusive annual window with at-least threshold
		VAR _Test9 = PQL.Assert.Partitions.ShouldBeAtLeast(
		    "Partitions.ShouldBeAtLeast: Inclusive range 2026-01-01..2027-01-01 should return count >= 33",
		    "Test Import 1 & 3",
		    33,
		    DATE(2026, 1, 1),
		    DATE(2027, 1, 1)
		)

		// ============================================
		// Test Group 5: Explicit BLANK() parameters
		// ============================================

		// Test 10: Explicit BLANK boundaries should match no-date-filter behavior
		VAR _Test10 = PQL.Assert.Partitions.ShouldBe(
		    "Partitions.ShouldBe: Explicit BLANK boundaries should return count = 34",
		    "Test Import 1 & 3",
		    34,
		    BLANK(),
		    BLANK()
		)

		// ============================================
		// Test Group 6: Edge cases and validation
		// ============================================

		// Test 11: Non-existent table should have zero partitions
		VAR _Test11 = PQL.Assert.Partitions.ShouldBe(
		    "Partitions.ShouldBe: NonExistentTable should return count = 0",
		    "NonExistentTable",
		    0
		)

		// Test 12: Repeat exact-count baseline check
		VAR _Test12 = PQL.Assert.Partitions.ShouldBe(
		    "Partitions.ShouldBe: Test Import 1 & 3 baseline should return count = 34",
		    "Test Import 1 & 3",
		    34
		)

		RETURN UNION(
		    _Test1,
		    _Test2,
		    _Test3,
		    _Test4,
		    _Test5,
		    _Test6,
		    _Test7,
		    _Test8,
		    _Test9,
		    _Test10,
		    _Test11,
		    _Test12
		)

EVALUATE Partition.ANY.Tests()
ORDER BY [Passed], [TestName]

/// Asserts that every value in a column is NULL (BLANK()) or an empty string (""). Deprecated: this is a duplicate of ShouldBeNullOrBlank (same logic and results), and its name suggests empty strings only. Use ShouldBeNullOrBlank.
function 'PQL.Assert.Col.ShouldBeBlank' =
		(testName : STRING, columnRef : ANYREF EXPR) =>
			VAR _NonBlankCount = COUNTAX(
				VALUES(columnRef),
				IF(NOT ISBLANK(columnRef) && FORMAT(columnRef, "") <> "", 1, BLANK())
			)
			VAR _TotalCount = COUNTROWS(VALUES(columnRef))
			VAR _Passed = _NonBlankCount = 0 && _TotalCount > 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "Column is all BLANK (empty string or NULL)",
				"Actual", IF(_Passed, "ALL BLANK", "HAS NON-BLANK VALUES (" & FORMAT(_NonBlankCount, "0") & " non-blank)"),
				"Passed", _Passed
			)
	lineageTag: ee101c5f-844e-4352-af78-d7357f72db8b

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that no value in a column is NULL (BLANK()) or an empty string (""). Deprecated: this is a duplicate of ShouldNotBeNullOrBlank (same logic and results), and its name suggests empty strings only. Use ShouldNotBeNullOrBlank, or BlankRateShouldBeAtMostV2(testName, tableRef, columnRef, 0) to check for empty strings only.
function 'PQL.Assert.Col.ShouldNotBeBlank' =
		(testName : STRING, columnRef : ANYREF EXPR) =>
			VAR _BlankCount = COUNTBLANK(columnRef)
			VAR _TotalCount = COUNTROWS(ALLNOBLANKROW(columnRef))
			VAR _Passed = _BlankCount = 0 && _TotalCount > 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "Column has no BLANK values (all non-empty and non-NULL)",
				"Actual", IF(_Passed, "NO BLANK VALUES", "HAS BLANK VALUES (" & FORMAT(_BlankCount, "0") & " blank)"),
				"Passed", _Passed
			)
	lineageTag: 85569eca-aeca-4745-ad11-b9f817d02ee5


// Example 3: Verify dimension table warming (expect 100% residency)
// EVALUATE PQL.Assert.DirectLake.Tbl.ResidencyRateShouldBeAtLeast(
//     "Customer dimension should be fully resident",
//     "Customer",
//     100
// )

// Example 4: Monitor fact table residency in production
// EVALUATE PQL.Assert.DirectLake.Tbl.ResidencyRateShouldBeAtLeast(
//     "Sales fact table should maintain at least 40% residency",
//     "Sales",
//     40
// )

// ============================================
// Production Monitoring Workflow
// ============================================

// 1. Pre-warming script runs (via Fabric notebook or Power Automate)
// 2. Wait 30 seconds for segments to load
// 3. Run residency tests to verify warming succeeded
// 4. Alert if critical columns fall below threshold
// 5. Re-run warming if needed


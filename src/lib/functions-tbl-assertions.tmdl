	/// Table Assertions - PQL.Assert.Tbl namespace
	/// Table-level assertion functions for schema and structure validation
	/// Publisher: PQL (Power Query Lint)
	/// Asserts that a table has at least one row.
	function 'PQL.Assert.Tbl.ShouldHaveRows' =
			(testName : STRING, tableRef : TABLE EXPR) =>
				VAR _RowCount = COUNTROWS(tableRef)
				VAR _Passed = _RowCount > 0
				RETURN ROW(
					"TestName", testName,
					"Expected", "Table has rows",
					"Actual", IF(_Passed, "HAS ROWS (" & FORMAT(_RowCount, "0") & ")", "EMPTY (0 rows)"),
					"Passed", _Passed
				)
		annotation DAXLIB_PackageId = PQL.Assert
		annotation DAXLIB_PackageVersion = 0.9.0

	/// Asserts that a table has exactly the expected number of rows.
	function 'PQL.Assert.Tbl.ShouldHaveRowCount' =
			(testName : STRING, tableRef : TABLE EXPR, expectedRowCount : INT64) =>
				VAR _RowCount = COUNTROWS(tableRef)
				VAR _Passed = _RowCount = expectedRowCount
				RETURN ROW(
					"TestName", testName,
					"Expected", FORMAT(expectedRowCount, "0") & " rows",
					"Actual", FORMAT(_RowCount, "0") & " rows",
					"Passed", _Passed
				)
		annotation DAXLIB_PackageId = PQL.Assert
		annotation DAXLIB_PackageVersion = 0.9.0

	/// Asserts that a table has more rows than the specified threshold.
	function 'PQL.Assert.Tbl.ShouldHaveMoreRowsThan' =
			(testName : STRING, threshold : INT64, tableToCheck : TABLE) =>
				VAR _RowCount = COUNTROWS(tableToCheck)
				VAR _Passed = _RowCount > threshold
				RETURN ROW(
					"TestName", testName,
					"Expected", "> " & FORMAT(threshold, "0"),
					"Actual", FORMAT(_RowCount, "0"),
					"Passed", _Passed
				)
		annotation DAXLIB_PackageId = PQL.Assert
		annotation DAXLIB_PackageVersion = 0.9.0

	/// Asserts that a table exists in the model.
	function 'PQL.Assert.Tbl.ShouldExist' =
			(testName : STRING, tableName : STRING) =>
				VAR _Tables = INFO.VIEW.TABLES()
				VAR _Found = COUNTROWS(FILTER(_Tables, [Name] = tableName)) > 0
				RETURN ROW(
					"TestName", testName,
					"Expected", "Table '" & tableName & "' exists",
					"Actual", IF(_Found, "EXISTS", "NOT FOUND"),
					"Passed", _Found
				)
		annotation DAXLIB_PackageId = PQL.Assert
		annotation DAXLIB_PackageVersion = 0.9.0

	/// Schema & Column Shape
	/// Asserts that a table has all the specified columns (comma-separated list).
	/// @param {STRING} testName - Description of the test being performed
	/// @param {STRING} tableName - Table name as text, e.g. "Sales" (not a table expression or 'Sales')
	/// @param {STRING} columnNamesList - Comma-separated column names, e.g. "OrderID,Amount"
	function 'PQL.Assert.Tbl.ShouldHaveColumns' =
			(testName : STRING, tableName : STRING, columnNamesList : STRING) =>
				VAR _Columns = INFO.VIEW.COLUMNS()
				VAR _TableColumns = FILTER(_Columns, [Table] = tableName)
				VAR _ExpectedCount = LEN(columnNamesList) - LEN(SUBSTITUTE(columnNamesList, ",", "")) + 1
				VAR _ColumnNamesUpper = UPPER(columnNamesList)
				VAR _MatchedColumns = FILTER(
					_TableColumns,
					CONTAINSSTRING("," & _ColumnNamesUpper & ",", "," & TRIM(UPPER([Name])) & ",")
				)
				VAR _MatchedCount = COUNTROWS(_MatchedColumns)
				VAR _MissingCount = _ExpectedCount - _MatchedCount
				VAR _ActualColumnNames = CONCATENATEX(_TableColumns, [Name], ", ", [Name], ASC)
				VAR _Passed = _MissingCount <= 0
				RETURN ROW(
					"TestName", testName,
					"Expected", "Table '" & tableName & "' has columns: " & columnNamesList,
					"Actual", IF(_Passed, "ALL COLUMNS FOUND", "MISSING " & FORMAT(_MissingCount, "0") & " COLUMN(S). Available: " & _ActualColumnNames),
					"Passed", _Passed
				)
		annotation DAXLIB_PackageId = PQL.Assert
		annotation DAXLIB_PackageVersion = 0.9.0

	/// Asserts that a table does not have extra columns beyond the allowed list (comma-separated).
	/// @param {STRING} testName - Description of the test being performed
	/// @param {STRING} tableName - Table name as text, e.g. "Sales" (not a table expression or 'Sales')
	/// @param {STRING} allowedColumnNamesList - Comma-separated allowed column names
	function 'PQL.Assert.Tbl.ShouldNotHaveExtraColumns' =
			(testName : STRING, tableName : STRING, allowedColumnNamesList : STRING) =>
				VAR _Columns = INFO.VIEW.COLUMNS()
				VAR _TableColumns = FILTER(_Columns, [Table] = tableName && [Type] <> "RowNumber")
				VAR _TableColumnCount = COUNTROWS(_TableColumns)
				VAR _AllowedUpper = UPPER(allowedColumnNamesList)
				VAR _ExtraColumns = FILTER(
					_TableColumns,
					NOT CONTAINSSTRING("," & _AllowedUpper & ",", "," & TRIM(UPPER([Name])) & ",")
				)
				VAR _ExtraCount = COUNTROWS(_ExtraColumns)
				VAR _ExtraList = CONCATENATEX(_ExtraColumns, [Name], ", ", [Name], ASC)
				VAR _Passed = _ExtraCount = 0
				RETURN ROW(
					"TestName", testName,
					"Expected", "No extra columns beyond: " & allowedColumnNamesList,
					"Actual", IF(_Passed, "NO EXTRA COLUMNS (" & FORMAT(_TableColumnCount, "0") & " columns)", "EXTRA COLUMNS FOUND (" & FORMAT(_ExtraCount, "0") & "): " & _ExtraList),
					"Passed", _Passed
				)
		annotation DAXLIB_PackageId = PQL.Assert
		annotation DAXLIB_PackageVersion = 0.9.0

	/// Asserts that a column in a table has the expected data type.
	/// @param {STRING} testName - Description of the test being performed
	/// @param {STRING} tableName - Table name as text, e.g. "Sales" (not a table expression or 'Sales')
	/// @param {STRING} columnName - Column name as text
	/// @param {STRING} expectedType - Expected data type as text
	function 'PQL.Assert.Tbl.ColumnDataTypeShouldBe' =
			(testName : STRING, tableName : STRING, columnName : STRING, expectedType : STRING) =>
				VAR _Columns = INFO.VIEW.COLUMNS()
				VAR _MatchingColumn = FILTER(_Columns, [Table] = tableName && [Name] = columnName)
				VAR _Found = COUNTROWS(_MatchingColumn) > 0
				VAR _ActualType = IF(_Found, MAXX(_MatchingColumn, [DataType]), "COLUMN NOT FOUND")
				VAR _Passed = _Found && UPPER(_ActualType) = UPPER(expectedType)
				RETURN ROW(
					"TestName", testName,
					"Expected", "Column '" & tableName & "[" & columnName & "]' data type = " & expectedType,
					"Actual", IF(_Found, "DataType = " & _ActualType, "COLUMN NOT FOUND"),
					"Passed", _Passed
				)
		annotation DAXLIB_PackageId = PQL.Assert
		annotation DAXLIB_PackageVersion = 0.9.0


	/// Asserts that every row of a key table is distinct, for composite keys of any width. Pass the key columns as a projection, e.g. SELECTCOLUMNS('Sales', "OrderID", 'Sales'[OrderID], "Line", 'Sales'[Line]). Blank key values are compared like any other value. Fails with NO ROWS when keyTable is empty.
	/// @param {STRING} testName - Description of the test being performed
	/// @param {TABLE} keyTable - Table expression holding only the key columns
	function 'PQL.Assert.Tbl.RowsShouldBeDistinct' =
			(testName : STRING, keyTable : TABLE EXPR) =>
				VAR _Rows = COUNTROWS(keyTable) + 0
				VAR _Distinct = COUNTROWS(DISTINCT(keyTable)) + 0
				VAR _Passed = _Rows > 0 && _Rows = _Distinct
				RETURN ROW(
					"TestName", testName,
					"Expected", "All key rows distinct",
					"Actual", IF(_Rows = 0, "NO ROWS", FORMAT(_Distinct, "0") & " distinct of " & FORMAT(_Rows, "0") & " rows"),
					"Passed", _Passed
				)
		annotation DAXLIB_PackageId = PQL.Assert
		annotation DAXLIB_PackageVersion = 0.9.0

	/// Asserts that a filtered table has at most maxCount rows. Pass the rows that break a rule, e.g. FILTER('Orders', NOT 'Orders'[Status] IN {"open", "closed"}). Zero matching rows passes, including on an empty table.
	/// @param {STRING} testName - Description of the test being performed
	/// @param {TABLE} filteredTable - Table expression holding the rows to count
	/// @param {INT64} maxCount - Largest allowed number of rows
	function 'PQL.Assert.Tbl.RowCountShouldBeAtMost' =
			(testName : STRING, filteredTable : TABLE EXPR, maxCount : INT64) =>
				VAR _Count = COUNTROWS(filteredTable) + 0
				VAR _Passed = _Count <= maxCount
				RETURN ROW(
					"TestName", testName,
					"Expected", "Matching rows <= " & FORMAT(maxCount, "0"),
					"Actual", FORMAT(_Count, "0"),
					"Passed", _Passed
				)
		annotation DAXLIB_PackageId = PQL.Assert
		annotation DAXLIB_PackageVersion = 0.9.0

	/// Asserts that a filtered table's rows are at most maxPct percent (0-100) of a base table's rows. Fails with NO ROWS when baseTable is empty.
	/// @param {STRING} testName - Description of the test being performed
	/// @param {TABLE} filteredTable - Table expression holding the rows to count, e.g. FILTER('Orders', ISBLANK('Orders'[ShipDate]))
	/// @param {TABLE} baseTable - Table expression to compare against, e.g. 'Orders'
	/// @param {DOUBLE} maxPct - Largest allowed share, as a percentage (0-100)
	function 'PQL.Assert.Tbl.RowRateShouldBeAtMost' =
			(testName : STRING, filteredTable : TABLE EXPR, baseTable : TABLE EXPR, maxPct : DOUBLE) =>
				VAR _Matching = COUNTROWS(filteredTable) + 0
				VAR _Rows = COUNTROWS(baseTable) + 0
				VAR _Pct = IF(_Rows = 0, 0, DIVIDE(_Matching * 100, _Rows))
				VAR _Passed = _Rows > 0 && _Pct <= maxPct
				RETURN ROW(
					"TestName", testName,
					"Expected", "Matching rows <= " & FORMAT(ROUND(maxPct, 2), "General Number") & "%",
					"Actual", IF(_Rows = 0, "NO ROWS", FORMAT(ROUND(_Pct, 2), "General Number") & "% (" & FORMAT(_Matching, "0") & " of " & FORMAT(_Rows, "0") & " rows)"),
					"Passed", _Passed
				)
		annotation DAXLIB_PackageId = PQL.Assert
		annotation DAXLIB_PackageVersion = 0.9.0

	/// Freshness: refresh recency (ODCS frequency)
	/// Asserts that the table's partitions were refreshed at most maxAgeHours hours before UTCNOW(). This checks that the refresh ran, not that the data is fresh: a refresh that succeeds against stale source data passes. To check data age (ODCS latency), use Col.MaxDateShouldBeWithinHours on a load or ingestion timestamp column. The newest partition refresh counts, so an incremental refresh that refreshes only recent partitions passes. An empty table that refreshed passes; use Tbl.ShouldHaveRows for row presence. Fails when the table is not found or none of its partitions has a refresh time; a partition that has never been refreshed reports RefreshedTime 1699-12-31 (seen in Power BI Desktop), which counts as no refresh. RefreshedTime is UTC in Power BI Desktop and the service, so it compares directly with UTCNOW(). A DirectQuery table (every partition Mode 1) is never refreshed, so it fails with DIRECTQUERY (no refresh); check data age on it with Col.MaxDateShouldBeWithinHours instead. On Direct Lake (Mode 5), RefreshedTime moves when the table reframes, including automatic updates; seen in the service, an automatic update moved only the table whose Delta table changed, so a rarely changing table can fail here while the model is up to date. Reads INFO.TABLES() and INFO.PARTITIONS(), like Partitions.ShouldExist.
	/// @param {STRING} testName - Description of the test being performed
	/// @param {STRING} tableName - Name of the table whose refresh to check, as text, e.g. "Orders"
	/// @param {DOUBLE} maxAgeHours - Largest allowed time since the last refresh, in hours
	function 'PQL.Assert.Tbl.LastRefreshShouldBeWithinHours' =
			(testName : STRING, tableName : STRING, maxAgeHours : DOUBLE) =>
				VAR _TableID = MAXX(FILTER(INFO.TABLES(), [Name] = tableName), [ID])
				VAR _Partitions = FILTER(INFO.PARTITIONS(), [TableID] = _TableID)
				VAR _IsDirectQuery = NOT ISEMPTY(_Partitions) && ISEMPTY(FILTER(_Partitions, [Mode] <> 1))
				VAR _Refreshed = MAXX(FILTER(_Partitions, [RefreshedTime] > DATE(1900, 1, 1)), [RefreshedTime])
				VAR _AgeHours = IF(ISBLANK(_Refreshed), BLANK(), (UTCNOW() - _Refreshed) * 24.0)
				VAR _Passed = NOT _IsDirectQuery && NOT ISBLANK(_AgeHours) && _AgeHours <= maxAgeHours
				RETURN ROW(
					"TestName", testName,
					"Expected", "Last refresh within " & FORMAT(ROUND(maxAgeHours, 2), "General Number") & " hour(s)",
					"Actual",
						SWITCH(
							TRUE(),
							ISBLANK(_TableID), "TABLE NOT FOUND",
							_IsDirectQuery, "DIRECTQUERY (no refresh)",
							ISBLANK(_Refreshed), "NEVER REFRESHED",
							"Last refresh " & FORMAT(ROUND(_AgeHours, 2), "General Number") & " hour(s) ago"
						),
					"Passed", _Passed
				)
		annotation DAXLIB_PackageId = PQL.Assert
		annotation DAXLIB_PackageVersion = 0.9.0

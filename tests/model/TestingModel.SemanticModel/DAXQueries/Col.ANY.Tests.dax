DEFINE
	FUNCTION Col.ANY.Tests = () =>
		// ============================================
		// Column Assertion Test Suite
		// Tests for PQL.Assert.Col namespace functions
		// ============================================

		// Test data references:
		// TestData: has columns ID (int), Name (string), Value (double), Category (string), IsActive (boolean), CreatedDate (date), NullableField (string)
		// TestData-Fact: same columns plus 'Blank Column' (calculated blank)
		// TestData has 5 rows: IDs 1-5, Values 100.5/200.75/150.25/300.0/50.0, Names Alpha/Beta/Gamma/Delta/Epsilon, Categories A/B/A/C/B

		// ============================================
		// EXISTING COL ASSERTIONS
		// ============================================

		// PQL.Assert.Col.ShouldBeNull
		VAR _Col_ShouldBeNull_Fail = PQL.Assert.Col.ShouldBeNull("Col.ShouldBeNull: ID column should fail (has values)", 'TestData'[ID])

		// PQL.Assert.Col.ShouldNotBeNull
		VAR _Col_ShouldNotBeNull_Pass = PQL.Assert.Col.ShouldNotBeNull("Col.ShouldNotBeNull: ID column should pass", 'TestData'[ID])

		// PQL.Assert.Col.ShouldBeBlank
		VAR _Col_ShouldBeBlank_Pass = PQL.Assert.Col.ShouldBeBlank("Col.ShouldBeBlank: Empty column should pass", 'TestData-Fact'[Blank Column])
		VAR _Col_ShouldBeBlank_Fail = PQL.Assert.Col.ShouldBeBlank("Col.ShouldBeBlank: NullableField should fail (has non-blank)", 'TestData-Fact'[NullableField])

		// PQL.Assert.Col.ShouldNotBeBlank
		VAR _Col_ShouldNotBeBlank_Pass = PQL.Assert.Col.ShouldNotBeBlank("Col.ShouldNotBeBlank: ID column should pass (all non-blank)", 'TestData'[ID])
		VAR _Col_ShouldNotBeBlank_Fail = PQL.Assert.Col.ShouldNotBeBlank("Col.ShouldNotBeBlank: Nullable column should fail (has blank)", 'TestData-Fact'[NullableField])

		// PQL.Assert.Col.ShouldBeNullOrBlank
		VAR _Col_ShouldBeNullOrBlank_Pass = PQL.Assert.Col.ShouldBeNullOrBlank("Col.ShouldBeNullOrBlank: Empty column should pass", 'TestData-Fact'[Blank Column])
		VAR _Col_ShouldBeNullOrBlank_Fail = PQL.Assert.Col.ShouldBeNullOrBlank("Col.ShouldBeNullOrBlank: ID column should fail (has values)", 'TestData'[ID])

		// PQL.Assert.Col.ShouldNotBeNullOrBlank
		VAR _Col_ShouldNotBeNullOrBlank_Pass = PQL.Assert.Col.ShouldNotBeNullOrBlank("Col.ShouldNotBeNullOrBlank: ID column should pass (no nulls/blanks)", 'TestData'[ID])
		VAR _Col_ShouldNotBeNullOrBlank_Fail = PQL.Assert.Col.ShouldNotBeNullOrBlank("Col.ShouldNotBeNullOrBlank: Nullable column should fail (has blank)", 'TestData-Fact'[NullableField])
		VAR _Blank_Pass_AllNull_Deprecated = PQL.Assert.Col.ShouldBeBlank("Col.ShouldBeBlank: Blank Column all NULL (deprecated duplicate of ShouldBeNullOrBlank) should pass", 'TestData-Fact'[Blank Column])
		VAR _NullCount_Pass_EmptyTextNotNull = PQL.Assert.Col.NullCountShouldBeAtMost("Col.NullCountShouldBeAtMost: Empty Text <=0 nulls (empty strings are not NULL) should pass", 'TestData', 'TestData'[Empty Text], 0)
		VAR _BlankRateV2_Fail_EmptyText = PQL.Assert.Col.BlankRateShouldBeAtMostV2("Col.BlankRateShouldBeAtMostV2: Empty Text <=99% (5 of 5 rows) should fail", 'TestData', 'TestData'[Empty Text], 99)
		VAR _NotBlank_Fail_Null_Deprecated = PQL.Assert.Col.ShouldNotBeBlank("Col.ShouldNotBeBlank: NullableField with NULLs and no empty strings (deprecated duplicate of ShouldNotBeNullOrBlank) should fail", 'TestData'[NullableField])

		// PQL.Assert.Col.ShouldBeDistinct
		VAR _Col_ShouldBeDistinct_Pass = PQL.Assert.Col.ShouldBeDistinct("Col.ShouldBeDistinct: ID column should pass", 'TestData'[ID])

		// PQL.Assert.Col.ShouldExist
		VAR _Col_ShouldExist_Pass = PQL.Assert.Col.ShouldExist("Col.ShouldExist: TestData[ID] should pass", "TestData", "ID")
		VAR _Col_ShouldExist_Fail = PQL.Assert.Col.ShouldExist("Col.ShouldExist: FakeTable[Col] should fail", "FakeTable", "Col")

		// ============================================
		// PRESENCE / COMPLETENESS THRESHOLDS
		// ============================================

		// PQL.Assert.Col.NullRateShouldBeAtMost
		// TestData NullableField: 2 nulls out of 5 = 40% null rate
		VAR _NullRate_Pass = PQL.Assert.Col.NullRateShouldBeAtMost("Col.NullRateShouldBeAtMost: NullableField <=50% should pass", 'TestData'[NullableField], 50)
		VAR _NullRate_Fail = PQL.Assert.Col.NullRateShouldBeAtMost("Col.NullRateShouldBeAtMost: NullableField <=10% should fail", 'TestData'[NullableField], 10)
		VAR _NullRate_Pass_NoNulls = PQL.Assert.Col.NullRateShouldBeAtMost("Col.NullRateShouldBeAtMost: ID <=0% should pass", 'TestData'[ID], 0)

		// PQL.Assert.Col.BlankRateShouldBeAtMost
		// ID column has no blanks
		VAR _BlankRate_Pass = PQL.Assert.Col.BlankRateShouldBeAtMost("Col.BlankRateShouldBeAtMost: ID <=0% should pass", 'TestData'[ID], 0)

		// PQL.Assert.Col.NullOrBlankRateShouldBeAtMost
		VAR _NullOrBlankRate_Pass = PQL.Assert.Col.NullOrBlankRateShouldBeAtMost("Col.NullOrBlankRateShouldBeAtMost: NullableField <=50% should pass", 'TestData'[NullableField], 50)
		VAR _NullOrBlankRate_Fail = PQL.Assert.Col.NullOrBlankRateShouldBeAtMost("Col.NullOrBlankRateShouldBeAtMost: NullableField <=10% should fail", 'TestData'[NullableField], 10)

		// PQL.Assert.Col.PopulatedRateShouldBeAtLeast
		// TestData NullableField: 3 populated out of 5 = 60% populated
		VAR _PopulatedRate_Pass = PQL.Assert.Col.PopulatedRateShouldBeAtLeast("Col.PopulatedRateShouldBeAtLeast: NullableField >=50% should pass", 'TestData'[NullableField], 50)
		VAR _PopulatedRate_Fail = PQL.Assert.Col.PopulatedRateShouldBeAtLeast("Col.PopulatedRateShouldBeAtLeast: NullableField >=90% should fail", 'TestData'[NullableField], 90)

		// ============================================
		// UNIQUENESS & KEY-LIKE BEHAVIOR
		// ============================================

		// PQL.Assert.Col.ShouldBeUniqueWithin
		// TestData: ID is unique within each Category
		VAR _UniqueWithin_Pass = PQL.Assert.Col.ShouldBeUniqueWithin("Col.ShouldBeUniqueWithin: ID unique within Category should pass", 'TestData'[ID], 'TestData'[Category])

		// PQL.Assert.Col.ComboShouldBeDistinct
		// TestData: (ID, Category) combo is distinct
		VAR _ComboDistinct_Pass = PQL.Assert.Col.ComboShouldBeDistinct("Col.ComboShouldBeDistinct: ID+Category combo should pass", 'TestData'[ID], 'TestData'[Category])

		// PQL.Assert.Col.ShouldNotContainDuplicates
		VAR _NoDupes_Pass = PQL.Assert.Col.ShouldNotContainDuplicates("Col.ShouldNotContainDuplicates: ID should pass", 'TestData'[ID])

		// ============================================
		// RANGE & DISTRIBUTION CHECKS
		// ============================================

		// PQL.Assert.Col.ShouldBeInRange
		// TestData Value: min=50.0, max=300.0
		VAR _InRange_Pass = PQL.Assert.Col.ShouldBeInRange("Col.ShouldBeInRange: Value [0,500] should pass", 'TestData'[Value], 0, 500)
		VAR _InRange_Fail = PQL.Assert.Col.ShouldBeInRange("Col.ShouldBeInRange: Value [0,100] should fail", 'TestData'[Value], 0, 100)

		// PQL.Assert.Col.MinShouldBeAtLeast
		VAR _MinAtLeast_Pass = PQL.Assert.Col.MinShouldBeAtLeast("Col.MinShouldBeAtLeast: Value >=0 should pass", 'TestData'[Value], 0)
		VAR _MinAtLeast_Fail = PQL.Assert.Col.MinShouldBeAtLeast("Col.MinShouldBeAtLeast: Value >=100 should fail", 'TestData'[Value], 100)

		// PQL.Assert.Col.MaxShouldBeAtMost
		VAR _MaxAtMost_Pass = PQL.Assert.Col.MaxShouldBeAtMost("Col.MaxShouldBeAtMost: Value <=500 should pass", 'TestData'[Value], 500)
		VAR _MaxAtMost_Fail = PQL.Assert.Col.MaxShouldBeAtMost("Col.MaxShouldBeAtMost: Value <=200 should fail", 'TestData'[Value], 200)

		// PQL.Assert.Col.PctileShouldBeInRange
		// TestData Value: 50, 100.5, 150.25, 200.75, 300 (sorted). P50 ~ 150.25
		VAR _Pctile_Pass = PQL.Assert.Col.PctileShouldBeInRange("Col.PctileShouldBeInRange: P50 of Value [100,200] should pass", 'TestData'[Value], 0.5, 100, 200)
		VAR _Pctile_Fail = PQL.Assert.Col.PctileShouldBeInRange("Col.PctileShouldBeInRange: P50 of Value [0,50] should fail", 'TestData'[Value], 0.5, 0, 50)

		// PQL.Assert.Col.MeanShouldBeInRange
		// TestData Value: mean = (100.5+200.75+150.25+300+50)/5 = 160.3
		VAR _Mean_Pass = PQL.Assert.Col.MeanShouldBeInRange("Col.MeanShouldBeInRange: Value [100,200] should pass", 'TestData'[Value], 100, 200)
		VAR _Mean_Fail = PQL.Assert.Col.MeanShouldBeInRange("Col.MeanShouldBeInRange: Value [0,100] should fail", 'TestData'[Value], 0, 100)

		// PQL.Assert.Col.StdDevShouldBeAtMost
		VAR _StdDev_Pass = PQL.Assert.Col.StdDevShouldBeAtMost("Col.StdDevShouldBeAtMost: Value <=200 should pass", 'TestData'[Value], 200)
		VAR _StdDev_Fail = PQL.Assert.Col.StdDevShouldBeAtMost("Col.StdDevShouldBeAtMost: Value <=10 should fail", 'TestData'[Value], 10)

		// PQL.Assert.Col.ShareOfZerosAtMost
		// TestData Value: no zeros, so 0%
		VAR _ZeroShare_Pass = PQL.Assert.Col.ShareOfZerosAtMost("Col.ShareOfZerosAtMost: Value <=5% should pass", 'TestData'[Value], 5)

		// PQL.Assert.Col.ShareOfEvensAtLeast
		// TestData ID: 1,2,3,4,5 => even: 2,4 => 40%
		VAR _EvenShare_Pass = PQL.Assert.Col.ShareOfEvensAtLeast("Col.ShareOfEvensAtLeast: ID >=30% should pass", 'TestData'[ID], 30)
		VAR _EvenShare_Fail = PQL.Assert.Col.ShareOfEvensAtLeast("Col.ShareOfEvensAtLeast: ID >=60% should fail", 'TestData'[ID], 60)

		// PQL.Assert.Col.ShareOfOddsAtLeast
		// TestData ID: 1,2,3,4,5 => odd: 1,3,5 => 60%
		VAR _OddShare_Pass = PQL.Assert.Col.ShareOfOddsAtLeast("Col.ShareOfOddsAtLeast: ID >=50% should pass", 'TestData'[ID], 50)
		VAR _OddShare_Fail = PQL.Assert.Col.ShareOfOddsAtLeast("Col.ShareOfOddsAtLeast: ID >=80% should fail", 'TestData'[ID], 80)

		// ============================================
		// SIGN & MONOTONICITY
		// ============================================

		// PQL.Assert.Col.ShouldBeNonNegative
		VAR _NonNeg_Pass = PQL.Assert.Col.ShouldBeNonNegative("Col.ShouldBeNonNegative: Value should pass", 'TestData'[Value])

		// PQL.Assert.Col.ShouldBePositive
		VAR _Positive_Pass = PQL.Assert.Col.ShouldBePositive("Col.ShouldBePositive: Value should pass", 'TestData'[Value])

		// PQL.Assert.Col.ShouldBeNonZero
		VAR _NonZero_Pass = PQL.Assert.Col.ShouldBeNonZero("Col.ShouldBeNonZero: Value should pass", 'TestData'[Value])
		VAR _ZerosV2_Pass = PQL.Assert.Col.ShareOfZerosAtMostV2("Col.ShareOfZerosAtMostV2: Signed With Blank <=50% (2 of 4 non-null rows) should pass", 'TestData', 'TestData'[Signed With Blank], 50)
		VAR _ZerosV2_Fail = PQL.Assert.Col.ShareOfZerosAtMostV2("Col.ShareOfZerosAtMostV2: Signed With Blank <=49% should fail", 'TestData', 'TestData'[Signed With Blank], 49)
		VAR _ZerosV2_Pass_NullNotZero = PQL.Assert.Col.ShareOfZerosAtMostV2("Col.ShareOfZerosAtMostV2: Dup With Blank <=0% (NULL is not zero) should pass", 'TestData', 'TestData'[Dup With Blank], 0)
		VAR _EvensV2_Pass = PQL.Assert.Col.ShareOfEvensAtLeastV2("Col.ShareOfEvensAtLeastV2: Signed With Blank >=75% (0, 0, 2 of 4 non-null rows) should pass", 'TestData', 'TestData'[Signed With Blank], 75)
		VAR _EvensV2_Fail_NullNotEven = PQL.Assert.Col.ShareOfEvensAtLeastV2("Col.ShareOfEvensAtLeastV2: Dup With Blank >=26% (NULL is not even, 1 of 4) should fail", 'TestData', 'TestData'[Dup With Blank], 26)
		VAR _OddsV2_Pass = PQL.Assert.Col.ShareOfOddsAtLeastV2("Col.ShareOfOddsAtLeastV2: Dup With Blank >=75% (1, 1, 3 of 4 non-null rows) should pass", 'TestData', 'TestData'[Dup With Blank], 75)
		VAR _OddsV2_Fail = PQL.Assert.Col.ShareOfOddsAtLeastV2("Col.ShareOfOddsAtLeastV2: Signed With Blank >=26% should fail", 'TestData', 'TestData'[Signed With Blank], 26)
		VAR _NonZero_Pass_NullSkipped = PQL.Assert.Col.ShouldBeNonZero("Col.ShouldBeNonZero: Distinct With Blank (NULL is not zero) should pass", 'TestData'[Distinct With Blank])
		VAR _NonZero_Fail_Zeros = PQL.Assert.Col.ShouldBeNonZero("Col.ShouldBeNonZero: Signed With Blank (two zeros) should fail", 'TestData'[Signed With Blank])
		VAR _Positive_Pass_NullSkipped = PQL.Assert.Col.ShouldBePositive("Col.ShouldBePositive: Distinct With Blank (NULL skipped) should pass", 'TestData'[Distinct With Blank])
		VAR _Positive_Fail_Signed = PQL.Assert.Col.ShouldBePositive("Col.ShouldBePositive: Signed With Blank (-1 and zeros) should fail", 'TestData'[Signed With Blank])

		// PQL.Assert.Col.ShouldBeMonotonicIncreasing
		// TestData ID: 1,2,3,4,5 ordered by ID is strictly increasing
		VAR _MonoInc_Pass = PQL.Assert.Col.ShouldBeMonotonicIncreasing("Col.ShouldBeMonotonicIncreasing: ID ordered by ID should pass", 'TestData'[ID], 'TestData'[ID])

		// PQL.Assert.Col.ShouldBeMonotonicNonDecreasing
		VAR _MonoNonDec_Pass = PQL.Assert.Col.ShouldBeMonotonicNonDecreasing("Col.ShouldBeMonotonicNonDecreasing: ID ordered by ID should pass", 'TestData'[ID], 'TestData'[ID])

		// PQL.Assert.Col.ShouldBeMonotonicDecreasing
		// TestData ID ordered by ID is increasing, so decreasing test should fail
		VAR _MonoDec_Fail = PQL.Assert.Col.ShouldBeMonotonicDecreasing("Col.ShouldBeMonotonicDecreasing: ID ordered by ID should fail", 'TestData'[ID], 'TestData'[ID])

		// ============================================
		// CATEGORICAL / MEMBERSHIP / FORMAT
		// ============================================

		// PQL.Assert.Col.ValuesShouldBeInSet
		// TestData Category: A, B, C
		VAR _ValuesInSet_Pass = PQL.Assert.Col.ValuesShouldBeInSet("Col.ValuesShouldBeInSet: Category in {A,B,C} should pass", 'TestData'[Category], {"A", "B", "C"}, [Value])
		VAR _ValuesInSet_Fail = PQL.Assert.Col.ValuesShouldBeInSet("Col.ValuesShouldBeInSet: Category in {A,B} should fail", 'TestData'[Category], {"A", "B"}, [Value])

		// PQL.Assert.Col.ValuesShouldNotBeInSet
		VAR _ValuesNotInSet_Pass = PQL.Assert.Col.ValuesShouldNotBeInSet("Col.ValuesShouldNotBeInSet: Category not in {X,Y} should pass", 'TestData'[Category], {"X", "Y"}, [Value])
		VAR _ValuesNotInSet_Fail = PQL.Assert.Col.ValuesShouldNotBeInSet("Col.ValuesShouldNotBeInSet: Category not in {A,X} should fail", 'TestData'[Category], {"A", "X"}, [Value])

		// PQL.Assert.Col.DistinctCountShouldBeAtMost
		// TestData Category: 3 distinct (A, B, C)
		VAR _DistAtMost_Pass = PQL.Assert.Col.DistinctCountShouldBeAtMost("Col.DistinctCountShouldBeAtMost: Category <=5 should pass", 'TestData'[Category], 5)
		VAR _DistAtMost_Fail = PQL.Assert.Col.DistinctCountShouldBeAtMost("Col.DistinctCountShouldBeAtMost: Category <=2 should fail", 'TestData'[Category], 2)

		// PQL.Assert.Col.DistinctCountShouldBeAtLeast
		VAR _DistAtLeast_Pass = PQL.Assert.Col.DistinctCountShouldBeAtLeast("Col.DistinctCountShouldBeAtLeast: Category >=2 should pass", 'TestData'[Category], 2)
		VAR _DistAtLeast_Fail = PQL.Assert.Col.DistinctCountShouldBeAtLeast("Col.DistinctCountShouldBeAtLeast: Category >=10 should fail", 'TestData'[Category], 10)

		// PQL.Assert.Col.TextShouldHaveNoLeadingOrTrailingSpaces
		VAR _NoSpaces_Pass = PQL.Assert.Col.TextShouldHaveNoLeadingOrTrailingSpaces("Col.TextShouldHaveNoLeadingOrTrailingSpaces: Name should pass", 'TestData'[Name])

		// PQL.Assert.Col.TextShouldBeTrimmed
		VAR _Trimmed_Pass = PQL.Assert.Col.TextShouldBeTrimmed("Col.TextShouldBeTrimmed: Name should pass", 'TestData'[Name])

		// PQL.Assert.Col.TextCaseShouldBeUpper
		// TestData Category: A, B, C - all uppercase
		VAR _Upper_Pass = PQL.Assert.Col.TextCaseShouldBeUpper("Col.TextCaseShouldBeUpper: Category should pass", 'TestData'[Category])
		// TestData Name: Alpha, Beta - not all uppercase
		VAR _Upper_Fail = PQL.Assert.Col.TextCaseShouldBeUpper("Col.TextCaseShouldBeUpper: Name should fail", 'TestData'[Name])

		// PQL.Assert.Col.TextCaseShouldBeLower
		// TestData Name: Alpha, Beta - not all lowercase
		VAR _Lower_Fail = PQL.Assert.Col.TextCaseShouldBeLower("Col.TextCaseShouldBeLower: Name should fail", 'TestData'[Name])

		// PQL.Assert.Col.TextLengthShouldBeInRange
		// TestData Name: Alpha(5), Beta(4), Gamma(5), Delta(5), Epsilon(7)
		VAR _TextLen_Pass = PQL.Assert.Col.TextLengthShouldBeInRange("Col.TextLengthShouldBeInRange: Name [3,10] should pass", 'TestData'[Name], 3, 10)
		VAR _TextLen_Fail = PQL.Assert.Col.TextLengthShouldBeInRange("Col.TextLengthShouldBeInRange: Name [5,5] should fail", 'TestData'[Name], 5, 5)

		// PQL.Assert.Col.IsAvailableInMDX
		VAR _IsAvailableInMDX_Pass =
		    SELECTCOLUMNS(
		        PQL.Assert.Col.IsAvailableInMDX("Col.IsAvailableInMDX: TestData[ID] should pass", "TestData", "ID"),
		        "TestName", [TestName],
		        "Expected", [Expected],
		        "Actual", [Actual],
		        "Passed", [Passed]
		    )
		VAR _IsAvailableInMDX_Fail =
		    SELECTCOLUMNS(
		        PQL.Assert.Col.IsAvailableInMDX("Col.IsAvailableInMDX: TestData[MDX Disabled Column] should fail", "TestData", "MDX Disabled Column"),
		        "TestName", [TestName],
		        "Expected", [Expected],
		        "Actual", [Actual],
		        "Passed", [Passed]
		    )

		// ============================================
		// TEXT PREFIX / SUFFIX / CONTAINS
		// TestData[Order Code] = ORD-001-US ... ORD-005-US
		// TestData[Name] = Alpha, Beta, Gamma, Delta, Epsilon
		// ============================================

		// PQL.Assert.Col.ShouldStartWith
		VAR _StartsWith_Pass = PQL.Assert.Col.ShouldStartWith("Col.ShouldStartWith: Order Code starts with 'ORD-' should pass", 'TestData'[Order Code], "ORD-")
		VAR _StartsWith_Pass_IgnoreCase = PQL.Assert.Col.ShouldStartWith("Col.ShouldStartWith: Order Code starts with 'ord-' case-insensitive should pass", 'TestData'[Order Code], "ord-")
		VAR _StartsWith_Fail_CaseSensitive = PQL.Assert.Col.ShouldStartWith("Col.ShouldStartWith: Order Code starts with 'ord-' case-sensitive should fail", 'TestData'[Order Code], "ord-", "Y")
		VAR _StartsWith_Fail = PQL.Assert.Col.ShouldStartWith("Col.ShouldStartWith: Name starts with 'Al' should fail", 'TestData'[Name], "Al")

		// PQL.Assert.Col.ShouldNotStartWith
		VAR _NotStartsWith_Pass = PQL.Assert.Col.ShouldNotStartWith("Col.ShouldNotStartWith: Order Code starts with 'INV-' should pass", 'TestData'[Order Code], "INV-")
		VAR _NotStartsWith_Pass_CaseSensitive = PQL.Assert.Col.ShouldNotStartWith("Col.ShouldNotStartWith: Order Code starts with 'ord-' case-sensitive should pass", 'TestData'[Order Code], "ord-", "Y")
		VAR _NotStartsWith_Fail = PQL.Assert.Col.ShouldNotStartWith("Col.ShouldNotStartWith: Order Code starts with 'ORD-' should fail", 'TestData'[Order Code], "ORD-")

		// PQL.Assert.Col.ShouldEndWith
		VAR _EndsWith_Pass = PQL.Assert.Col.ShouldEndWith("Col.ShouldEndWith: Order Code ends with '-US' should pass", 'TestData'[Order Code], "-US")
		VAR _EndsWith_Pass_IgnoreCase = PQL.Assert.Col.ShouldEndWith("Col.ShouldEndWith: Order Code ends with '-us' case-insensitive should pass", 'TestData'[Order Code], "-us")
		VAR _EndsWith_Fail_CaseSensitive = PQL.Assert.Col.ShouldEndWith("Col.ShouldEndWith: Order Code ends with '-us' case-sensitive should fail", 'TestData'[Order Code], "-us", "Y")
		VAR _EndsWith_Fail = PQL.Assert.Col.ShouldEndWith("Col.ShouldEndWith: Name ends with 'a' should fail", 'TestData'[Name], "a")

		// PQL.Assert.Col.ShouldNotEndWith
		VAR _NotEndsWith_Pass = PQL.Assert.Col.ShouldNotEndWith("Col.ShouldNotEndWith: Order Code ends with '-CA' should pass", 'TestData'[Order Code], "-CA")
		VAR _NotEndsWith_Pass_CaseSensitive = PQL.Assert.Col.ShouldNotEndWith("Col.ShouldNotEndWith: Order Code ends with '-us' case-sensitive should pass", 'TestData'[Order Code], "-us", "Y")
		VAR _NotEndsWith_Fail = PQL.Assert.Col.ShouldNotEndWith("Col.ShouldNotEndWith: Order Code ends with '-US' should fail", 'TestData'[Order Code], "-US")

		// PQL.Assert.Col.ShouldContainString
		VAR _Contains_Pass = PQL.Assert.Col.ShouldContainString("Col.ShouldContainString: Order Code contains '-00' should pass", 'TestData'[Order Code], "-00")
		VAR _Contains_Pass_CaseSensitive = PQL.Assert.Col.ShouldContainString("Col.ShouldContainString: Order Code contains 'ORD' case-sensitive should pass", 'TestData'[Order Code], "ORD", "Y")
		VAR _Contains_Fail_CaseSensitive = PQL.Assert.Col.ShouldContainString("Col.ShouldContainString: Order Code contains 'ord' case-sensitive should fail", 'TestData'[Order Code], "ord", "Y")
		VAR _Contains_Fail = PQL.Assert.Col.ShouldContainString("Col.ShouldContainString: Name contains 'a' should fail", 'TestData'[Name], "a")

		// PQL.Assert.Col.ShouldNotContainString
		VAR _NotContains_Pass = PQL.Assert.Col.ShouldNotContainString("Col.ShouldNotContainString: Order Code contains 'XYZ' should pass", 'TestData'[Order Code], "XYZ")
		VAR _NotContains_Pass_CaseSensitive = PQL.Assert.Col.ShouldNotContainString("Col.ShouldNotContainString: Order Code contains 'ord' case-sensitive should pass", 'TestData'[Order Code], "ord", "Y")
		VAR _NotContains_Fail = PQL.Assert.Col.ShouldNotContainString("Col.ShouldNotContainString: Order Code contains 'ORD' should fail", 'TestData'[Order Code], "ORD")

		// Blank values are skipped
		// TestData[Sparse Code] = ORD-001-US, (blank), ORD-003-US, (blank), ORD-005-US
		VAR _StartsWith_Pass_SkipsBlanks = PQL.Assert.Col.ShouldStartWith("Col.ShouldStartWith: Sparse Code starts with 'ORD-' ignoring blanks should pass", 'TestData'[Sparse Code], "ORD-")
		VAR _NotStartsWith_Pass_SkipsBlanks = PQL.Assert.Col.ShouldNotStartWith("Col.ShouldNotStartWith: Sparse Code starts with 'INV-' ignoring blanks should pass", 'TestData'[Sparse Code], "INV-")
		VAR _EndsWith_Pass_SkipsBlanks = PQL.Assert.Col.ShouldEndWith("Col.ShouldEndWith: Sparse Code ends with '-US' ignoring blanks should pass", 'TestData'[Sparse Code], "-US")
		VAR _NotEndsWith_Pass_SkipsBlanks = PQL.Assert.Col.ShouldNotEndWith("Col.ShouldNotEndWith: Sparse Code ends with '-CA' ignoring blanks should pass", 'TestData'[Sparse Code], "-CA")
		VAR _Contains_Pass_SkipsBlanks = PQL.Assert.Col.ShouldContainString("Col.ShouldContainString: Sparse Code contains '-00' ignoring blanks should pass", 'TestData'[Sparse Code], "-00")
		VAR _NotContains_Pass_SkipsBlanks = PQL.Assert.Col.ShouldNotContainString("Col.ShouldNotContainString: Sparse Code contains 'XYZ' ignoring blanks should pass", 'TestData'[Sparse Code], "XYZ")

		// Values shorter than the prefix/suffix (LEFT/RIGHT past the end of the value)
		// TestData[Short Text] = "x", "", "Error - Timeout", "Err", (blank)
		// TestData[Category] = A, B, C
		VAR _StartsWith_Fail_ValueShorterThanPrefix = PQL.Assert.Col.ShouldStartWith("Col.ShouldStartWith: Short Text starts with 'Error - ' ('x' is shorter than prefix) should fail", 'TestData'[Short Text], "Error - ")
		VAR _NotStartsWith_Pass_PrefixLongerThanValue = PQL.Assert.Col.ShouldNotStartWith("Col.ShouldNotStartWith: Category starts with 'Error - ' (prefix longer than every value) should pass", 'TestData'[Category], "Error - ")
		VAR _NotStartsWith_Pass_ValueIsPrefixOfPrefix = PQL.Assert.Col.ShouldNotStartWith("Col.ShouldNotStartWith: Short Text starts with 'Error - Timeout - Retry' (value is only a prefix of the prefix) should pass", 'TestData'[Short Text], "Error - Timeout - Retry")
		VAR _NotStartsWith_Fail_ShortText = PQL.Assert.Col.ShouldNotStartWith("Col.ShouldNotStartWith: Short Text starts with 'Error - ' should fail", 'TestData'[Short Text], "Error - ")
		VAR _EndsWith_Fail_ValueShorterThanSuffix = PQL.Assert.Col.ShouldEndWith("Col.ShouldEndWith: Short Text ends with ' - Timeout' ('x' is shorter than suffix) should fail", 'TestData'[Short Text], " - Timeout")
		VAR _NotEndsWith_Pass_SuffixLongerThanValue = PQL.Assert.Col.ShouldNotEndWith("Col.ShouldNotEndWith: Category ends with ' - Error' (suffix longer than every value) should pass", 'TestData'[Category], " - Error")
		VAR _NotEndsWith_Pass_ValueIsSuffixOfSuffix = PQL.Assert.Col.ShouldNotEndWith("Col.ShouldNotEndWith: Short Text ends with 'Big Error - Timeout' (value is only a suffix of the suffix) should pass", 'TestData'[Short Text], "Big Error - Timeout")
		VAR _Contains_Fail_ValueShorterThanSearch = PQL.Assert.Col.ShouldContainString("Col.ShouldContainString: Short Text contains 'Error - ' ('x' is shorter than search text) should fail", 'TestData'[Short Text], "Error - ")
		VAR _NotContains_Pass_SearchLongerThanValue = PQL.Assert.Col.ShouldNotContainString("Col.ShouldNotContainString: Category contains 'Error - ' (search text longer than every value) should pass", 'TestData'[Category], "Error - ")

		// Empty prefix/suffix matches every value
		VAR _StartsWith_Pass_EmptyPrefix = PQL.Assert.Col.ShouldStartWith("Col.ShouldStartWith: Short Text starts with '' (empty prefix) should pass", 'TestData'[Short Text], "")
		VAR _NotEndsWith_Fail_EmptySuffix = PQL.Assert.Col.ShouldNotEndWith("Col.ShouldNotEndWith: Short Text ends with '' (empty suffix) should fail", 'TestData'[Short Text], "")

		// ============================================
		// 0.8.0 ASSERTIONS
		// ============================================

		VAR _NullCount_Pass = PQL.Assert.Col.NullCountShouldBeAtMost("Col.NullCountShouldBeAtMost: NullableField <=2 nulls should pass", 'TestData', 'TestData'[NullableField], 2)
		VAR _NullCount_Fail = PQL.Assert.Col.NullCountShouldBeAtMost("Col.NullCountShouldBeAtMost: NullableField <=0 nulls should fail", 'TestData', 'TestData'[NullableField], 0)
		VAR _NullCount_Pass_NoNulls = PQL.Assert.Col.NullCountShouldBeAtMost("Col.NullCountShouldBeAtMost: ID <=0 nulls should pass", 'TestData', 'TestData'[ID], 0)
		VAR _NullCount_Pass_EmptyStringNotNull = PQL.Assert.Col.NullCountShouldBeAtMost("Col.NullCountShouldBeAtMost: Short Text <=1 null (empty string is not null) should pass", 'TestData', 'TestData'[Short Text], 1)
		VAR _NullRateV2_Pass = PQL.Assert.Col.NullRateShouldBeAtMostV2("Col.NullRateShouldBeAtMostV2: NullableField <=40% (2 of 5 rows) should pass", 'TestData', 'TestData'[NullableField], 40)
		VAR _NullRateV2_Fail = PQL.Assert.Col.NullRateShouldBeAtMostV2("Col.NullRateShouldBeAtMostV2: NullableField <=39.99% should fail", 'TestData', 'TestData'[NullableField], 39.99)
		VAR _NullRateV2_Pass_EmptyTable = PQL.Assert.Col.NullRateShouldBeAtMostV2("Col.NullRateShouldBeAtMostV2: empty table (NO ROWS) should fail", FILTER('TestData', FALSE), 'TestData'[NullableField], 0)
		VAR _BlankRateV2_Pass = PQL.Assert.Col.BlankRateShouldBeAtMostV2("Col.BlankRateShouldBeAtMostV2: Short Text <=20% (1 empty string of 5 rows) should pass", 'TestData', 'TestData'[Short Text], 20)
		VAR _BlankRateV2_Fail = PQL.Assert.Col.BlankRateShouldBeAtMostV2("Col.BlankRateShouldBeAtMostV2: Short Text <=10% should fail", 'TestData', 'TestData'[Short Text], 10)
		VAR _BlankRateV2_Pass_Numeric = PQL.Assert.Col.BlankRateShouldBeAtMostV2("Col.BlankRateShouldBeAtMostV2: ID <=0% (numeric column) should pass", 'TestData', 'TestData'[ID], 0)
		VAR _NullOrBlankRateV2_Pass = PQL.Assert.Col.NullOrBlankRateShouldBeAtMostV2("Col.NullOrBlankRateShouldBeAtMostV2: Short Text <=40% (2 of 5 rows) should pass", 'TestData', 'TestData'[Short Text], 40)
		VAR _NullOrBlankRateV2_Fail = PQL.Assert.Col.NullOrBlankRateShouldBeAtMostV2("Col.NullOrBlankRateShouldBeAtMostV2: Short Text <=30% should fail", 'TestData', 'TestData'[Short Text], 30)
		VAR _PopulatedRateV2_Pass = PQL.Assert.Col.PopulatedRateShouldBeAtLeastV2("Col.PopulatedRateShouldBeAtLeastV2: Short Text >=60% (3 of 5 rows) should pass", 'TestData', 'TestData'[Short Text], 60)
		VAR _PopulatedRateV2_Fail = PQL.Assert.Col.PopulatedRateShouldBeAtLeastV2("Col.PopulatedRateShouldBeAtLeastV2: Short Text >=61% should fail", 'TestData', 'TestData'[Short Text], 61)
		VAR _NonNullDistinct_Pass = PQL.Assert.Col.NonNullValuesShouldBeDistinct("Col.NonNullValuesShouldBeDistinct: Distinct With Blank (null ignored) should pass", 'TestData'[Distinct With Blank])
		VAR _NonNullDistinct_Fail = PQL.Assert.Col.NonNullValuesShouldBeDistinct("Col.NonNullValuesShouldBeDistinct: Dup With Blank {1,1,2,3,BLANK} should fail", 'TestData'[Dup With Blank])
		VAR _PrimaryKey_Pass = PQL.Assert.Col.ShouldBePrimaryKey("Col.ShouldBePrimaryKey: ID should pass", 'TestData'[ID])
		VAR _PrimaryKey_Fail_Blank = PQL.Assert.Col.ShouldBePrimaryKey("Col.ShouldBePrimaryKey: Distinct With Blank (one BLANK) should fail", 'TestData'[Distinct With Blank])
		VAR _PrimaryKey_Fail_Dupes = PQL.Assert.Col.ShouldBePrimaryKey("Col.ShouldBePrimaryKey: Category (duplicates) should fail", 'TestData'[Category])
		VAR _DupCount_Pass = PQL.Assert.Col.DuplicateCountShouldBeAtMost("Col.DuplicateCountShouldBeAtMost: Dup With Blank <=1 should pass", 'TestData'[Dup With Blank], 1)
		VAR _DupCount_Fail = PQL.Assert.Col.DuplicateCountShouldBeAtMost("Col.DuplicateCountShouldBeAtMost: Dup With Blank <=0 should fail", 'TestData'[Dup With Blank], 0)
		VAR _DupCount_Pass_IgnoresBlank = PQL.Assert.Col.DuplicateCountShouldBeAtMost("Col.DuplicateCountShouldBeAtMost: Distinct With Blank <=0 (null ignored) should pass", 'TestData'[Distinct With Blank], 0)
		VAR _Distinct_Pass_KnownFalsePass = PQL.Assert.Col.ShouldBeDistinct("Col.ShouldBeDistinct: Dup With Blank {1,1,2,3,BLANK} (deprecated, known false pass) should pass", 'TestData'[Dup With Blank])
		VAR _Distinct_Fail_OneBlank = PQL.Assert.Col.ShouldBeDistinct("Col.ShouldBeDistinct: Distinct With Blank (deprecated, one BLANK fails) should fail", 'TestData'[Distinct With Blank])
		VAR _MaxDate_Pass = PQL.Assert.Col.MaxDateShouldBeWithinDays("Col.MaxDateShouldBeWithinDays: CreatedDate within 1000000 days should pass", 'TestData'[CreatedDate], 1000000)
		VAR _MaxDate_Fail = PQL.Assert.Col.MaxDateShouldBeWithinDays("Col.MaxDateShouldBeWithinDays: CreatedDate within 30 days should fail", 'TestData'[CreatedDate], 30)
		VAR _MaxDateHours_Pass = PQL.Assert.Col.MaxDateShouldBeWithinHours("Col.MaxDateShouldBeWithinHours: CreatedDate within 1000000 hours should pass", 'TestData'[CreatedDate], 1000000)
		VAR _MaxDateHours_Fail = PQL.Assert.Col.MaxDateShouldBeWithinHours("Col.MaxDateShouldBeWithinHours: CreatedDate within 3 hours should fail", 'TestData'[CreatedDate], 3)

		// ============================================
		// Combine All Test Results
		// ============================================
		VAR _AllTests = UNION(
		    // Existing Col Assertions
		    _Col_ShouldBeNull_Fail,
		    _Col_ShouldNotBeNull_Pass,
		    _Col_ShouldBeBlank_Pass,
		    _Col_ShouldBeBlank_Fail,
		    _Col_ShouldNotBeBlank_Pass,
		    _Col_ShouldNotBeBlank_Fail,
		    _Col_ShouldBeNullOrBlank_Pass,
		    _Col_ShouldBeNullOrBlank_Fail,
		    _Col_ShouldNotBeNullOrBlank_Pass,
		    _Col_ShouldNotBeNullOrBlank_Fail,
		    _Blank_Pass_AllNull_Deprecated,
		    _NullCount_Pass_EmptyTextNotNull,
		    _BlankRateV2_Fail_EmptyText,
		    _NotBlank_Fail_Null_Deprecated,
		    _Col_ShouldBeDistinct_Pass,
		    _Col_ShouldExist_Pass,
		    _Col_ShouldExist_Fail,

		    // Presence / Completeness
		    _NullRate_Pass,
		    _NullRate_Fail,
		    _NullRate_Pass_NoNulls,
		    _BlankRate_Pass,
		    _NullOrBlankRate_Pass,
		    _NullOrBlankRate_Fail,
		    _PopulatedRate_Pass,
		    _PopulatedRate_Fail,

		    // Uniqueness
		    _UniqueWithin_Pass,
		    _ComboDistinct_Pass,
		    _NoDupes_Pass,

		    // Range & Distribution
		    _InRange_Pass,
		    _InRange_Fail,
		    _MinAtLeast_Pass,
		    _MinAtLeast_Fail,
		    _MaxAtMost_Pass,
		    _MaxAtMost_Fail,
		    _Pctile_Pass,
		    _Pctile_Fail,
		    _Mean_Pass,
		    _Mean_Fail,
		    _StdDev_Pass,
		    _StdDev_Fail,
		    _ZeroShare_Pass,
		    _EvenShare_Pass,
		    _EvenShare_Fail,
		    _OddShare_Pass,
		    _OddShare_Fail,

		    // Sign & Monotonicity
		    _NonNeg_Pass,
		    _Positive_Pass,
		    _NonZero_Pass,
		    _ZerosV2_Pass,
		    _ZerosV2_Fail,
		    _ZerosV2_Pass_NullNotZero,
		    _EvensV2_Pass,
		    _EvensV2_Fail_NullNotEven,
		    _OddsV2_Pass,
		    _OddsV2_Fail,
		    _NonZero_Pass_NullSkipped,
		    _NonZero_Fail_Zeros,
		    _Positive_Pass_NullSkipped,
		    _Positive_Fail_Signed,
		    _MonoInc_Pass,
		    _MonoNonDec_Pass,
		    _MonoDec_Fail,

		    // Categorical / Membership / Format
		    _ValuesInSet_Pass,
		    _ValuesInSet_Fail,
		    _ValuesNotInSet_Pass,
		    _ValuesNotInSet_Fail,
		    _DistAtMost_Pass,
		    _DistAtMost_Fail,
		    _DistAtLeast_Pass,
		    _DistAtLeast_Fail,
		    _NoSpaces_Pass,
		    _Trimmed_Pass,
		    _Upper_Pass,
		    _Upper_Fail,
		    _Lower_Fail,
		    _TextLen_Pass,
		    _TextLen_Fail,
		    _IsAvailableInMDX_Pass,
		    _IsAvailableInMDX_Fail,

		    // Text Prefix / Suffix / Contains
		    _StartsWith_Pass,
		    _StartsWith_Pass_IgnoreCase,
		    _StartsWith_Fail_CaseSensitive,
		    _StartsWith_Fail,
		    _NotStartsWith_Pass,
		    _NotStartsWith_Pass_CaseSensitive,
		    _NotStartsWith_Fail,
		    _EndsWith_Pass,
		    _EndsWith_Pass_IgnoreCase,
		    _EndsWith_Fail_CaseSensitive,
		    _EndsWith_Fail,
		    _NotEndsWith_Pass,
		    _NotEndsWith_Pass_CaseSensitive,
		    _NotEndsWith_Fail,
		    _Contains_Pass,
		    _Contains_Pass_CaseSensitive,
		    _Contains_Fail_CaseSensitive,
		    _Contains_Fail,
		    _NotContains_Pass,
		    _NotContains_Pass_CaseSensitive,
		    _NotContains_Fail,
		    _StartsWith_Pass_SkipsBlanks,
		    _NotStartsWith_Pass_SkipsBlanks,
		    _EndsWith_Pass_SkipsBlanks,
		    _NotEndsWith_Pass_SkipsBlanks,
		    _Contains_Pass_SkipsBlanks,
		    _NotContains_Pass_SkipsBlanks,
		    _StartsWith_Fail_ValueShorterThanPrefix,
		    _NotStartsWith_Pass_PrefixLongerThanValue,
		    _NotStartsWith_Pass_ValueIsPrefixOfPrefix,
		    _NotStartsWith_Fail_ShortText,
		    _EndsWith_Fail_ValueShorterThanSuffix,
		    _NotEndsWith_Pass_SuffixLongerThanValue,
		    _NotEndsWith_Pass_ValueIsSuffixOfSuffix,
		    _Contains_Fail_ValueShorterThanSearch,
		    _NotContains_Pass_SearchLongerThanValue,
		    _StartsWith_Pass_EmptyPrefix,
		    _NotEndsWith_Fail_EmptySuffix,
		    _NullCount_Pass,
		    _NullCount_Fail,
		    _NullCount_Pass_NoNulls,
		    _NullCount_Pass_EmptyStringNotNull,
		    _NullRateV2_Pass,
		    _NullRateV2_Fail,
		    _NullRateV2_Pass_EmptyTable,
		    _BlankRateV2_Pass,
		    _BlankRateV2_Fail,
		    _BlankRateV2_Pass_Numeric,
		    _NullOrBlankRateV2_Pass,
		    _NullOrBlankRateV2_Fail,
		    _PopulatedRateV2_Pass,
		    _PopulatedRateV2_Fail,
		    _NonNullDistinct_Pass,
		    _NonNullDistinct_Fail,
		    _PrimaryKey_Pass,
		    _PrimaryKey_Fail_Blank,
		    _PrimaryKey_Fail_Dupes,
		    _DupCount_Pass,
		    _DupCount_Fail,
		    _DupCount_Pass_IgnoresBlank,
		    _Distinct_Pass_KnownFalsePass,
		    _Distinct_Fail_OneBlank,
		    _MaxDate_Pass,
		    _MaxDate_Fail,
		    _MaxDateHours_Pass,
		    _MaxDateHours_Fail
		)

		// ============================================
		// TEST VALIDATION LAYER
		// Checks if test names match actual results
		// ============================================
		VAR _ValidationResults =
		    ADDCOLUMNS(
		        _AllTests,
		        "ExpectedToPass",
		            CONTAINSSTRING([TestName], "should pass"),
		        "ExpectedToFail",
		            CONTAINSSTRING([TestName], "should fail"),
		        "HasExpectation",
		            CONTAINSSTRING([TestName], "should pass") || CONTAINSSTRING([TestName], "should fail"),
		        "ValidationStatus",
		            SWITCH(
		                TRUE(),
		                CONTAINSSTRING([TestName], "should pass") && [Passed] = TRUE, "✅ CORRECT",
		                CONTAINSSTRING([TestName], "should fail") && [Passed] = FALSE, "✅ CORRECT",
		                CONTAINSSTRING([TestName], "should pass") && [Passed] = FALSE, "❌ MISMATCH: Expected PASS but got FAIL",
		                CONTAINSSTRING([TestName], "should fail") && [Passed] = TRUE, "❌ MISMATCH: Expected FAIL but got PASS",
		                "⚠️ NO CLEAR EXPECTATION"
		            )
		    )
		RETURN
		    // One row per assertion: Passed means it behaved as its name says
		    // ("should pass" / "should fail"). Assertions without an expectation keep their own result.
		    SELECTCOLUMNS(
		        _ValidationResults,
		        "TestName", [TestName],
		        "Expected", [Expected],
		        "Actual", [Actual] & " [" & [ValidationStatus] & "]",
		        "Passed",
		            SWITCH(
		                TRUE(),
		                CONTAINSSTRING([ValidationStatus], "MISMATCH"), FALSE,
		                CONTAINSSTRING([ValidationStatus], "CORRECT"), TRUE,
		                [Passed]
		            )
		    )

EVALUATE Col.ANY.Tests()
ORDER BY [Passed], [TestName]

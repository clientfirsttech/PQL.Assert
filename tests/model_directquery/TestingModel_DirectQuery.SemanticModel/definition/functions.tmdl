/// Asserts that a column has at most maxCount NULL (BLANK()) rows. Pass 0 to require that no row is NULL. Empty strings ("") are not NULL; use BlankRateShouldBeAtMostV2 or NullOrBlankRateShouldBeAtMostV2 for those.
/// @param {STRING} testName - Description of the test being performed
/// @param {TABLE} tableRef - Table that holds the column, e.g. 'Sales'. Its rows are counted (a column reference alone gives distinct values, not rows).
/// @param {ANYREF} columnRef - Column in tableRef, e.g. 'Sales'[CustomerID]
/// @param {INT64} maxCount - Largest allowed number of NULL rows
function 'PQL.Assert.Col.NullCountShouldBeAtMost' =
		(testName : STRING, tableRef : TABLE EXPR, columnRef : ANYREF EXPR, maxCount : INT64) =>
			VAR _NullCount = COUNTROWS(FILTER(tableRef, ISBLANK(columnRef))) + 0
			VAR _Passed = _NullCount <= maxCount
			RETURN ROW(
				"TestName", testName,
				"Expected", "Null count <= " & FORMAT(maxCount, "0"),
				"Actual", FORMAT(_NullCount, "0") & " null(s)",
				"Passed", _Passed
			)
	lineageTag: 72347538-a0e9-4a0c-aaaa-6f70cbcb2269

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that the share of NULL (BLANK()) rows in a column is at most maxNullPct percent (0-100). Counts rows of tableRef, unlike NullRateShouldBeAtMost, which divides by distinct values. Empty strings ("") are not NULL. Fails with NO ROWS when tableRef is empty.
/// @param {STRING} testName - Description of the test being performed
/// @param {TABLE} tableRef - Table that holds the column, e.g. 'Sales'
/// @param {ANYREF} columnRef - Column in tableRef, e.g. 'Sales'[CustomerID]
/// @param {DOUBLE} maxNullPct - Largest allowed NULL share, as a percentage (0-100)
function 'PQL.Assert.Col.NullRateShouldBeAtMostV2' =
		(testName : STRING, tableRef : TABLE EXPR, columnRef : ANYREF EXPR, maxNullPct : DOUBLE) =>
			VAR _Rows = COUNTROWS(tableRef) + 0
			VAR _NullCount = COUNTROWS(FILTER(tableRef, ISBLANK(columnRef))) + 0
			VAR _NullPct = IF(_Rows = 0, 0, DIVIDE(_NullCount * 100, _Rows))
			VAR _Passed = _Rows > 0 && _NullPct <= maxNullPct
			RETURN ROW(
				"TestName", testName,
				"Expected", "Null rate <= " & FORMAT(ROUND(maxNullPct, 2), "General Number") & "%",
				"Actual", IF(_Rows = 0, "NO ROWS", FORMAT(ROUND(_NullPct, 2), "General Number") & "% (" & FORMAT(_NullCount, "0") & " of " & FORMAT(_Rows, "0") & " rows)"),
				"Passed", _Passed
			)
	lineageTag: f17f468f-e534-4b5f-9ab1-2b4df7cc76e9

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that the share of empty-string ("") rows in a column is at most maxBlankPct percent (0-100). NULL (BLANK()) rows are not counted. Counts rows of tableRef, unlike BlankRateShouldBeAtMost, which divides by distinct values. Works on columns of any data type. Fails with NO ROWS when tableRef is empty.
/// @param {STRING} testName - Description of the test being performed
/// @param {TABLE} tableRef - Table that holds the column, e.g. 'Sales'
/// @param {ANYREF} columnRef - Column in tableRef, e.g. 'Sales'[Region]
/// @param {DOUBLE} maxBlankPct - Largest allowed empty-string share, as a percentage (0-100)
function 'PQL.Assert.Col.BlankRateShouldBeAtMostV2' =
		(testName : STRING, tableRef : TABLE EXPR, columnRef : ANYREF EXPR, maxBlankPct : DOUBLE) =>
			VAR _Rows = COUNTROWS(tableRef) + 0
			VAR _BlankCount = COUNTROWS(FILTER(tableRef, NOT ISBLANK(columnRef) && LEN(columnRef) = 0)) + 0
			VAR _BlankPct = IF(_Rows = 0, 0, DIVIDE(_BlankCount * 100, _Rows))
			VAR _Passed = _Rows > 0 && _BlankPct <= maxBlankPct
			RETURN ROW(
				"TestName", testName,
				"Expected", "Blank rate <= " & FORMAT(ROUND(maxBlankPct, 2), "General Number") & "%",
				"Actual", IF(_Rows = 0, "NO ROWS", FORMAT(ROUND(_BlankPct, 2), "General Number") & "% (" & FORMAT(_BlankCount, "0") & " of " & FORMAT(_Rows, "0") & " rows)"),
				"Passed", _Passed
			)
	lineageTag: 8fe22d31-387e-4c4e-bd79-8f718bf70e21

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that the share of NULL (BLANK()) or empty-string ("") rows in a column is at most maxPct percent (0-100). Counts rows of tableRef, unlike NullOrBlankRateShouldBeAtMost, which divides by distinct values. Fails with NO ROWS when tableRef is empty.
/// @param {STRING} testName - Description of the test being performed
/// @param {TABLE} tableRef - Table that holds the column, e.g. 'Sales'
/// @param {ANYREF} columnRef - Column in tableRef, e.g. 'Sales'[Region]
/// @param {DOUBLE} maxPct - Largest allowed NULL-or-empty share, as a percentage (0-100)
function 'PQL.Assert.Col.NullOrBlankRateShouldBeAtMostV2' =
		(testName : STRING, tableRef : TABLE EXPR, columnRef : ANYREF EXPR, maxPct : DOUBLE) =>
			VAR _Rows = COUNTROWS(tableRef) + 0
			VAR _EmptyCount = COUNTROWS(FILTER(tableRef, LEN(columnRef) = 0)) + 0
			VAR _EmptyPct = IF(_Rows = 0, 0, DIVIDE(_EmptyCount * 100, _Rows))
			VAR _Passed = _Rows > 0 && _EmptyPct <= maxPct
			RETURN ROW(
				"TestName", testName,
				"Expected", "Null or blank rate <= " & FORMAT(ROUND(maxPct, 2), "General Number") & "%",
				"Actual", IF(_Rows = 0, "NO ROWS", FORMAT(ROUND(_EmptyPct, 2), "General Number") & "% (" & FORMAT(_EmptyCount, "0") & " of " & FORMAT(_Rows, "0") & " rows)"),
				"Passed", _Passed
			)
	lineageTag: fa5fcce2-a0fe-4733-8724-fa2cf2380f10


/// Asserts that no text values in a column have leading or trailing spaces. Fails with NO VALUES when the column has no non-NULL value. (Changed in 0.8.0: 0.7.x could pass a column with no values.)
function 'PQL.Assert.Col.TextShouldHaveNoLeadingOrTrailingSpaces' =
		(testName : STRING, columnRef : ANYREF EXPR) =>
			VAR _TotalCount = COUNTROWS(ALLNOBLANKROW(columnRef))
			VAR _UntrimmedCount = COUNTAX(ALLNOBLANKROW(columnRef), IF(NOT ISBLANK(columnRef) && FORMAT(columnRef, "") <> TRIM(FORMAT(columnRef, "")), 1, BLANK()))
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _Passed = _HasValues && (_UntrimmedCount = 0)
			RETURN ROW(
				"TestName", testName,
				"Expected", "No leading or trailing spaces",
				"Actual", IF(_HasValues, IF(_Passed, "ALL TRIMMED (" & FORMAT(_TotalCount, "0") & " rows)", "UNTRIMMED VALUES (" & FORMAT(_UntrimmedCount, "0") & " of " & FORMAT(_TotalCount, "0") & ")"), "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: cebda54d-0c8d-48a7-b235-db51d4ec8f3c


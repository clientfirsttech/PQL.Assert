/// Asserts that a column contains at least one non-NULL value (not DAX BLANK()). It does not check that no row is NULL; for that, use NullCountShouldBeAtMost(testName, tableRef, columnRef, 0).
function 'PQL.Assert.Col.ShouldNotBeNull' =
		(testName : STRING, columnRef : ANYREF EXPR) =>
			VAR _NonNullCount = DISTINCTCOUNTNOBLANK(columnRef)
			VAR _Passed = _NonNullCount > 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "Column has non-NULL values",
				"Actual", IF(_Passed, "HAS VALUES (" & FORMAT(_NonNullCount, "0") & " distinct)", "ALL NULL"),
				"Passed", _Passed
			)
	lineageTag: 66567ec6-81bc-4a5f-a28b-01c2cc3736dc


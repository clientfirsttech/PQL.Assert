/// Partition Assertions - PQL.Assert.Partition namespace
/// These functions validate partition configurations in semantic models
/// Asserts that a table has the expected number of partitions, with optional date range filtering.
/// Uses INFO.PARTITIONS() to check partition counts for data quality and model structure validation. This checks partition structure, not freshness: an incremental refresh policy creates a partition for a date range whether or not the source delivered rows for it.
/// @param {STRING} testName - Description of the test being performed
/// @param {STRING} tableName - Name of the table to check partitions for
/// @param {INT64} expectedCount - Expected number of partitions
/// @param {DATETIME} [startDate] - Optional start date filter (filters by RangeStart >= startDate)
/// @param {DATETIME} [endDate] - Optional end date filter (filters by RangeEnd <= endDate)
function 'PQL.Assert.Partitions.ShouldBe' =
		(testName: STRING, tableName: STRING, expectedCount: INT64, startDate: DATETIME = BLANK(), endDate: DATETIME = BLANK()) =>
		    VAR _Partitions = INFO.PARTITIONS()
		    VAR _Tables =
		        SELECTCOLUMNS(
		            INFO.TABLES(),
		            "TableID", [ID],
		            "TableName", [Name]
		        )
		    VAR _PartitionMetadata = NATURALLEFTOUTERJOIN(_Partitions, _Tables)
		    VAR _PartitionMetadataWithDates =
		        ADDCOLUMNS(
		            _PartitionMetadata,
		            "_RangeStartDate", IFERROR(DATEVALUE([RangeStart]), BLANK()),
		            "_RangeEndDate", IFERROR(DATEVALUE([RangeEnd]), BLANK())
		        )
		    VAR _Filtered =
		        FILTER(
		            _PartitionMetadataWithDates,
		            [TableName] = tableName
		            && (
		                ISBLANK(startDate)
		                || (NOT ISBLANK([_RangeStartDate]) && [_RangeStartDate] >= startDate)
		            )
		            && (
		                ISBLANK(endDate)
		                || (NOT ISBLANK([_RangeEndDate]) && [_RangeEndDate] <= endDate)
		            )
		        )
		    VAR _ActualCount = COUNTROWS(_Filtered)
		    VAR _Passed = _ActualCount = expectedCount
		    VAR _DateFilter =
		        IF(
		            NOT ISBLANK(startDate) || NOT ISBLANK(endDate),
		            " (Inclusive date bounds: " &
		            IF(NOT ISBLANK(startDate), "Start >= " & FORMAT(startDate, "yyyy-MM-dd"), "") &
		            IF(NOT ISBLANK(startDate) && NOT ISBLANK(endDate), ", ", "") &
		            IF(NOT ISBLANK(endDate), "End <= " & FORMAT(endDate, "yyyy-MM-dd"), "") &
		            ")",
		            ""
		        )
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Partition count = " & FORMAT(expectedCount, "0") & _DateFilter,
		        "Actual", "Partition count = " & FORMAT(_ActualCount, "0") & " for table '" & tableName & "'",
		        "Passed", _Passed
		    )
	lineageTag: c3b01c1b-0760-429f-bef0-983d8baff829

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0


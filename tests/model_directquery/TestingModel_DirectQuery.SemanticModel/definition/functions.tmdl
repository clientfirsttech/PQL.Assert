/// Uniqueness & Key-Like Behavior
/// Asserts that column values are unique within partitions defined by another column. Fails with NO VALUES when the column has no non-NULL value. (Changed in 0.8.0: 0.7.x could pass a column with no values.)
function 'PQL.Assert.Col.ShouldBeUniqueWithin' =
		(testName : STRING, columnRef : ANYREF EXPR, partitionByCol : ANYREF EXPR) =>
			VAR _Base = FILTER(ALL(partitionByCol, columnRef), NOT ISBLANK(columnRef))
			VAR _TotalCombinations = COUNTROWS(DISTINCT(_Base))
			VAR _TotalRows = COUNTA(columnRef)
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef), NOT ISBLANK(columnRef)))
			VAR _Passed = _HasValues && (_TotalCombinations = _TotalRows)
			RETURN ROW(
				"TestName", testName,
				"Expected", "All values unique within partition",
				"Actual", IF(_HasValues, IF(_Passed, "ALL UNIQUE WITHIN PARTITION (" & FORMAT(_TotalRows, "0") & " rows)", "DUPLICATES WITHIN PARTITION (" & FORMAT(_TotalCombinations, "0") & " unique of " & FORMAT(_TotalRows, "0") & " rows)"), "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: b038698f-4643-45e5-8151-1c1c28975eeb

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.9.0

/// Asserts that the combination of two columns forms a distinct composite key. Fails with NO VALUES when the column has no non-NULL value. (Changed in 0.8.0: 0.7.x could pass a column with no values.)
function 'PQL.Assert.Col.ComboShouldBeDistinct' =
		(testName : STRING, columnRef1 : ANYREF EXPR, columnRef2 : ANYREF EXPR) =>
			VAR _Base = FILTER(ALL(columnRef1, columnRef2), NOT ISBLANK(columnRef1))
			VAR _DistinctCombos = COUNTROWS(DISTINCT(_Base))
			VAR _TotalRows = COUNTA(columnRef1)
			VAR _HasValues = NOT ISEMPTY(FILTER(ALLNOBLANKROW(columnRef1), NOT ISBLANK(columnRef1)))
			VAR _Passed = _HasValues && (_DistinctCombos = _TotalRows)
			RETURN ROW(
				"TestName", testName,
				"Expected", "All combinations distinct (composite key)",
				"Actual", IF(_HasValues, IF(_Passed, "ALL COMBOS DISTINCT (" & FORMAT(_TotalRows, "0") & " rows)", "DUPLICATE COMBOS (" & FORMAT(_DistinctCombos, "0") & " distinct of " & FORMAT(_TotalRows, "0") & " rows)"), "NO VALUES"),
				"Passed", _Passed
			)
	lineageTag: 2364bca8-14e7-4e48-8809-e1895e833bff

